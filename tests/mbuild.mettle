import "mbuild/api";

// Test programs for crypto. They are a separate package that depends on
// crypto by path, so every build here also proves that a dependent links
// libsodium with no flags of its own. Run them from the crypto root with
// `mbuild test-programs`.
fn project() {
  mb_package("crypto_tests", "0.1.0");
  mb_bin("t_hash", "t_hash.mettle");
  mb_bin("t_mac", "t_mac.mettle");
  mb_bin("t_sign", "t_sign.mettle");
  mb_bin("t_kx", "t_kx.mettle");
  mb_bin("t_aead", "t_aead.mettle");
  mb_bin("t_pwhash", "t_pwhash.mettle");
  mb_bin("t_encode", "t_encode.mettle");
  mb_bin("t_random", "t_random.mettle");
  mb_bin("t_signed", "t_signed.mettle");
  mb_bin("t_token", "t_token.mettle");
  mb_bin("t_seal", "t_seal.mettle");
}

fn deps() {
  mb_dep_path("crypto", "..");
}
