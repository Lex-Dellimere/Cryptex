// Project Wycheproof vectors (tests/vectors/vec_wp_*.mettle): X25519, Ed25519 verify,
// ChaCha20-Poly1305,
// XChaCha20-Poly1305, HMAC-SHA1/256/512 and HKDF-SHA256. The last field of each
// row is "v" (must succeed and match) or "i" (must be rejected).
import "crypto/crypto";
import "crypto/hash/sha1";
import "tcheck";
import "vectors/vec_wp_x25519";
import "vectors/vec_wp_ed25519";
import "vectors/vec_wp_chachapoly";
import "vectors/vec_wp_xchachapoly";
import "vectors/vec_wp_hmac_sha1";
import "vectors/vec_wp_hmac_sha256";
import "vectors/vec_wp_hmac_sha512";
import "vectors/vec_wp_hkdf";

// Parses an unpadded lowercase hex number.
fn wp_parse_hex_int(s: string) -> int64 {
  var v: int64 = 0;
  var i: int64 = 0;
  while (i < (int64)s.length) {
    var c: int32 = (int32)s.chars[i];
    var d: int32 = c - 48;
    if (c >= 97) { d = c - 97 + 10; }
    v = v * 16 + (int64)d;
    i = i + 1;
  }
  return v;
}

fn wp_x25519() {
  var sk: CrX25519Secret;
  var pk: CrX25519Public;
  var want: uint8[32];
  var out: CrX25519Shared;
  var rows: int32 = 0;
  for r in 0..VEC_WP_X25519_N {
    var row: string = VEC_WP_X25519[r];
    var label: string = "x25519 row {r}";
    var e: string = tc_field(row, 3);
    tc_ok(label + " decoded", tc_unhex(tc_field(row, 0), &sk.b[0], 32) == 32
      && tc_unhex(tc_field(row, 1), &pk.b[0], 32) == 32
      && tc_unhex(tc_field(row, 2), &want[0], 32) == 32);
    tc_fill(&out.b[0], 32, 255);
    var rc: int32 = cr_x25519_shared(&out, &sk, &pk);
    if (e == "v") {
      tc_rc(label + " rc", rc, CR_OK);
      tc_ok(label + " shared", cr_equal(&out.b[0], &want[0], 32));
    } else {
      tc_rc(label + " rc (invalid)", rc, CR_E_KEY);
      tc_ok(label + " output zero", tc_all_zero(&out.b[0], 32));
    }
    rows = rows + 1;
  }
  tc_ok("x25519 row count", rows == VEC_WP_X25519_N);
}

fn wp_ed25519() {
  var pk: CrEd25519Public;
  var sig: CrEd25519Sig;
  var msg: uint8[1024];
  var sigbuf: uint8[96];
  var rows: int32 = 0;
  for r in 0..VEC_WP_ED25519_N {
    var row: string = VEC_WP_ED25519[r];
    var label: string = "ed25519 row {r}";
    var e: string = tc_field(row, 3);
    var pklen: int64 = tc_unhex(tc_field(row, 0), &pk.b[0], 32);
    var n: int64 = tc_unhex(tc_field(row, 1), &msg[0], 1024);
    var slen: int64 = tc_unhex(tc_field(row, 2), &sigbuf[0], 96);
    tc_ok(label + " decoded", pklen == 32 && n >= 0 && slen >= 0);
    if (slen != 64) {
      tc_ok(label + " wrong-size signature is invalid", e == "i");
    } else {
      for i in 0..64 { sig.b[i] = sigbuf[i]; }
      tc_ok(label + " verify (" + e + ")", cr_ed25519_verify(&sig, &msg[0], n, &pk) == (e == "v"));
    }
    rows = rows + 1;
  }
  tc_ok("ed25519 row count", rows == VEC_WP_ED25519_N);
}

// key|iv|aad|msg|ct_and_tag|e through the 12-byte (IETF) API.
fn wp_chachapoly() {
  var key: CrKey32;
  var nonce: CrNonce12;
  var aad: uint8[528];
  var msg: uint8[528];
  var want: uint8[560];
  var ct: uint8[560];
  var pt: uint8[560];
  var rows: int32 = 0;
  for r in 0..VEC_WP_CHACHAPOLY_N {
    var row: string = VEC_WP_CHACHAPOLY[r];
    var label: string = "chachapoly row {r}";
    var e: string = tc_field(row, 5);
    var klen: int64 = tc_unhex(tc_field(row, 0), &key.b[0], 32);
    var nlen: int64 = tc_unhex(tc_field(row, 1), &nonce.b[0], 12);
    var alen: int64 = tc_unhex(tc_field(row, 2), &aad[0], 528);
    var mlen: int64 = tc_unhex(tc_field(row, 3), &msg[0], 528);
    var wlen: int64 = tc_unhex(tc_field(row, 4), &want[0], 560);
    tc_ok(label + " decoded", klen == 32 && nlen == 12 && alen >= 0 && mlen >= 0 && wlen >= 0);
    var adp: uint8* = &aad[0];
    if (alen == 0) { adp = 0; }
    var mp: uint8* = &msg[0];
    if (mlen == 0) { mp = 0; }
    var plen: int64 = 99;
    tc_fill(&pt[0], 560, 255);
    var rc: int32 = cr_chacha20poly1305_decrypt(&pt[0], 560, &plen, &want[0], wlen, adp, alen, &nonce, &key);
    if (e == "v") {
      var clen: int64 = 0;
      tc_rc(label + " encrypt", cr_chacha20poly1305_encrypt(&ct[0], 560, &clen, mp, mlen, adp, alen, &nonce, &key), CR_OK);
      tc_ok(label + " ciphertext", clen == wlen && cr_equal(&ct[0], &want[0], wlen));
      tc_rc(label + " decrypt", rc, CR_OK);
      tc_ok(label + " plaintext", plen == mlen && cr_equal(&pt[0], &msg[0], mlen));
    } else {
      tc_rc(label + " decrypt (invalid)", rc, CR_E_VERIFY);
      tc_ok(label + " plaintext buffer zero", tc_all_zero(&pt[0], 560));
    }
    rows = rows + 1;
  }
  tc_ok("chachapoly row count", rows == VEC_WP_CHACHAPOLY_N);
}

// key|iv|aad|msg|ct_and_tag|e through the 24-byte (XChaCha20) API.
fn wp_xchachapoly() {
  var key: CrKey32;
  var nonce: CrNonce24;
  var aad: uint8[528];
  var msg: uint8[528];
  var want: uint8[560];
  var ct: uint8[560];
  var pt: uint8[560];
  var rows: int32 = 0;
  for r in 0..VEC_WP_XCHACHAPOLY_N {
    var row: string = VEC_WP_XCHACHAPOLY[r];
    var label: string = "xchachapoly row {r}";
    var e: string = tc_field(row, 5);
    var klen: int64 = tc_unhex(tc_field(row, 0), &key.b[0], 32);
    var nlen: int64 = tc_unhex(tc_field(row, 1), &nonce.b[0], 24);
    var alen: int64 = tc_unhex(tc_field(row, 2), &aad[0], 528);
    var mlen: int64 = tc_unhex(tc_field(row, 3), &msg[0], 528);
    var wlen: int64 = tc_unhex(tc_field(row, 4), &want[0], 560);
    tc_ok(label + " decoded", klen == 32 && nlen == 24 && alen >= 0 && mlen >= 0 && wlen >= 0);
    var adp: uint8* = &aad[0];
    if (alen == 0) { adp = 0; }
    var mp: uint8* = &msg[0];
    if (mlen == 0) { mp = 0; }
    var plen: int64 = 99;
    tc_fill(&pt[0], 560, 255);
    var rc: int32 = cr_aead_decrypt(&pt[0], 560, &plen, &want[0], wlen, adp, alen, &nonce, &key);
    if (e == "v") {
      var clen: int64 = 0;
      tc_rc(label + " encrypt", cr_aead_encrypt(&ct[0], 560, &clen, mp, mlen, adp, alen, &nonce, &key), CR_OK);
      tc_ok(label + " ciphertext", clen == wlen && cr_equal(&ct[0], &want[0], wlen));
      tc_rc(label + " decrypt", rc, CR_OK);
      tc_ok(label + " plaintext", plen == mlen && cr_equal(&pt[0], &msg[0], mlen));
    } else {
      tc_rc(label + " decrypt (invalid)", rc, CR_E_VERIFY);
      tc_ok(label + " plaintext buffer zero", tc_all_zero(&pt[0], 560));
    }
    rows = rows + 1;
  }
  tc_ok("xchachapoly row count", rows == VEC_WP_XCHACHAPOLY_N);
}

// Compares the first tlen bytes of the computed tag with the expected tag.
fn wp_tag_check(label: string, full: uint8*, fulllen: int64, want: uint8*, tlen: int64, e: string) {
  var same: bool = false;
  if (tlen >= 0 && tlen <= fulllen) {
    same = cr_equal(full, want, tlen);
  }
  tc_ok(label + " (" + e + ")", same == (e == "v"));
}

fn wp_hmac_sha1() {
  var key: uint8[96];
  var msg: uint8[288];
  var want: uint8[96];
  var full: uint8[20];
  var rows: int32 = 0;
  for r in 0..VEC_WP_HMAC_SHA1_N {
    var row: string = VEC_WP_HMAC_SHA1[r];
    var label: string = "hmac_sha1 row {r}";
    var klen: int64 = tc_unhex(tc_field(row, 0), &key[0], 96);
    var mlen: int64 = tc_unhex(tc_field(row, 1), &msg[0], 288);
    var tlen: int64 = tc_unhex(tc_field(row, 2), &want[0], 96);
    tc_ok(label + " decoded", klen >= 0 && mlen >= 0 && tlen >= 0);
    crx_hmac_sha1(&full[0], &key[0], klen, &msg[0], mlen);
    wp_tag_check(label, &full[0], 20, &want[0], tlen, tc_field(row, 3));
    rows = rows + 1;
  }
  tc_ok("hmac_sha1 row count", rows == VEC_WP_HMAC_SHA1_N);
}

fn wp_hmac_sha256() {
  var key: uint8[96];
  var msg: uint8[288];
  var want: uint8[96];
  var full: CrHmacSha256;
  var rows: int32 = 0;
  for r in 0..VEC_WP_HMAC_SHA256_N {
    var row: string = VEC_WP_HMAC_SHA256[r];
    var label: string = "hmac_sha256 row {r}";
    var klen: int64 = tc_unhex(tc_field(row, 0), &key[0], 96);
    var mlen: int64 = tc_unhex(tc_field(row, 1), &msg[0], 288);
    var tlen: int64 = tc_unhex(tc_field(row, 2), &want[0], 96);
    tc_ok(label + " decoded", klen >= 0 && mlen >= 0 && tlen >= 0);
    tc_rc(label + " rc", cr_hmac_sha256(&full, &key[0], klen, &msg[0], mlen), CR_OK);
    wp_tag_check(label, &full.b[0], 32, &want[0], tlen, tc_field(row, 3));
    rows = rows + 1;
  }
  tc_ok("hmac_sha256 row count", rows == VEC_WP_HMAC_SHA256_N);
}

fn wp_hmac_sha512() {
  var key: uint8[96];
  var msg: uint8[288];
  var want: uint8[96];
  var full: CrHmacSha512;
  var rows: int32 = 0;
  for r in 0..VEC_WP_HMAC_SHA512_N {
    var row: string = VEC_WP_HMAC_SHA512[r];
    var label: string = "hmac_sha512 row {r}";
    var klen: int64 = tc_unhex(tc_field(row, 0), &key[0], 96);
    var mlen: int64 = tc_unhex(tc_field(row, 1), &msg[0], 288);
    var tlen: int64 = tc_unhex(tc_field(row, 2), &want[0], 96);
    tc_ok(label + " decoded", klen >= 0 && mlen >= 0 && tlen >= 0);
    tc_rc(label + " rc", cr_hmac_sha512(&full, &key[0], klen, &msg[0], mlen), CR_OK);
    wp_tag_check(label, &full.b[0], 64, &want[0], tlen, tc_field(row, 3));
    rows = rows + 1;
  }
  tc_ok("hmac_sha512 row count", rows == VEC_WP_HMAC_SHA512_N);
}

// ikm|salt|info|size_hex|okm|e
fn wp_hkdf() {
  var ikm: uint8[96];
  var salt: uint8[96];
  var info: uint8[96];
  var out: uint8[8160];
  var want: uint8[8160];
  var rows: int32 = 0;
  for r in 0..VEC_WP_HKDF_N {
    var row: string = VEC_WP_HKDF[r];
    var label: string = "hkdf row {r}";
    var e: string = tc_field(row, 5);
    var il: int64 = tc_unhex(tc_field(row, 0), &ikm[0], 96);
    var sl: int64 = tc_unhex(tc_field(row, 1), &salt[0], 96);
    var nl: int64 = tc_unhex(tc_field(row, 2), &info[0], 96);
    tc_ok(label + " decoded", il >= 0 && sl >= 0 && nl >= 0);
    var size: int64 = wp_parse_hex_int(tc_field(row, 3));
    tc_fill(&out[0], 8160, 255);
    if (e == "v") {
      var wl: int64 = tc_unhex(tc_field(row, 4), &want[0], 8160);
      tc_ok(label + " okm decoded", wl == size && size >= 1 && size <= 8160);
      tc_rc(label + " rc", cr_hkdf_sha256(&out[0], size, &salt[0], sl, &ikm[0], il, &info[0], nl), CR_OK);
      tc_ok(label + " okm", cr_equal(&out[0], &want[0], size));
    } else {
      tc_ok(label + " size over the limit", size > 8160);
      tc_rc(label + " rc (invalid)", cr_hkdf_sha256(&out[0], size, &salt[0], sl, &ikm[0], il, &info[0], nl), CR_E_ARG);
    }
    rows = rows + 1;
  }
  tc_ok("hkdf row count", rows == VEC_WP_HKDF_N);
}

fn main() -> int32 {
  wp_x25519();
  wp_ed25519();
  wp_chachapoly();
  wp_xchachapoly();
  wp_hmac_sha1();
  wp_hmac_sha256();
  wp_hmac_sha512();
  wp_hkdf();
  return tc_finish("wycheproof");
}
