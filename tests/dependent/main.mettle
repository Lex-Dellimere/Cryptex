import "std/io";
import "std/conv";
import "crypto/crypto";

fn main() -> int32 {
  var msg: string = "abc";
  var d: CrSha256;
  if (cr_sha256(&d, msg.chars, (int64)msg.length) != CR_OK) { return 1; }
  var hx: uint8[65];
  var n: int64 = 0;
  if (cr_hex_encode(&hx[0], 65, &n, &d.b[0], 32) != CR_OK) { return 1; }
  var got: string = str_from_bytes((cstring)&hx[0], n);
  if (got != "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") {
    println("FAILED dependent: sha256(abc) = " + got);
    return 1;
  }
  println("OK dependent (sha256 abc via import \"crypto/crypto\")");
  return 0;
}
