// Ed25519: RFC 8032 section 7.1 TEST 1 (empty message) and TEST 2 (0x72).
import "cryptex/cryptex";
import "tcheck";

fn ed_case(label: string, seed_hex: string, pk_hex: string, msg_hex: string, sig_hex: string) {
  var seed: CrSeed32;
  tc_unhex(seed_hex, &seed.b[0], 32);
  var msg: uint8[8];
  var mlen: int64 = tc_unhex(msg_hex, &msg[0], 8);
  var pk: CrEd25519Public;
  var sk: CrEd25519Secret;
  tc_rc(label + " seed keypair", cr_ed25519_seed_keypair(&pk, &sk, &seed), CR_OK);
  tc_hex_eq(label + " public key", &pk.b[0], 32, pk_hex);
  tc_hex_eq(label + " sk = seed || pk", &sk.b[0], 64, seed_hex + pk_hex);
  var sig: CrEd25519Sig;
  tc_rc(label + " sign", cr_ed25519_sign(&sig, &msg[0], mlen, &sk), CR_OK);
  tc_hex_eq(label + " signature", &sig.b[0], 64, sig_hex);
  tc_ok(label + " verify", cr_ed25519_verify(&sig, &msg[0], mlen, &pk));
  var other: uint8[1] = [1];
  tc_ok(label + " other message rejected", !cr_ed25519_verify(&sig, &other[0], 1, &pk));
  sig.b[10] = sig.b[10] ^ 4;
  tc_ok(label + " bad signature rejected", !cr_ed25519_verify(&sig, &msg[0], mlen, &pk));
  cr_wipe(&sk.b[0], 64);
  cr_wipe(&seed.b[0], 32);
}

fn main() -> int32 {
  ed_case("rfc8032 test 1",
    "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60",
    "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a",
    "",
    "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b");
  ed_case("rfc8032 test 2",
    "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb",
    "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c",
    "72",
    "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00");

  // Random key pair round trip; the wrong key fails.
  var pk: CrEd25519Public;
  var sk: CrEd25519Secret;
  var pk2: CrEd25519Public;
  var sk2: CrEd25519Secret;
  tc_rc("keypair", cr_ed25519_keypair(&pk, &sk), CR_OK);
  tc_rc("keypair 2", cr_ed25519_keypair(&pk2, &sk2), CR_OK);
  var m: string = "release v0.1.0 sha256=...";
  var sig: CrEd25519Sig;
  tc_rc("sign random", cr_ed25519_sign(&sig, m.chars, (int64)m.length, &sk), CR_OK);
  tc_ok("verify random", cr_ed25519_verify(&sig, m.chars, (int64)m.length, &pk));
  tc_ok("wrong key rejected", !cr_ed25519_verify(&sig, m.chars, (int64)m.length, &pk2));
  tc_ok("truncated message rejected", !cr_ed25519_verify(&sig, m.chars, (int64)m.length - 1, &pk));
  tc_rc("sign null sk", cr_ed25519_sign(&sig, m.chars, 3, 0), CR_E_ARG);
  tc_ok("sign error zeroes sig", tc_all_zero(&sig.b[0], 64));
  tc_ok("verify null pk", !cr_ed25519_verify(&sig, m.chars, 3, 0));
  tc_ok("verify neg len", !cr_ed25519_verify(&sig, m.chars, -1, &pk));
  cr_wipe(&sk.b[0], 64);
  cr_wipe(&sk2.b[0], 64);
  return tc_finish("sign");
}
