// NIST P-384 key pairs, ECDH and ECDSA (FIPS 186-5, SEC 1 v2, RFC 6979): NIST
// CAVP key pair, ECDH, public key validation and SigVer rows
// (tests/vectors/vec_cavp_*_384), Wycheproof ECDH and ECDSA rows
// (tests/vectors/vec_wp_*_384*), the RFC 6979 appendix A.2.6 signatures, sign
// and verify round trips with random keys, two-party ECDH agreement, scalar
// and public key edge cases, wiping, argument checks, strict DER, and the
// internal point routines ECDSA is built on.
//
// Row formats, hex fields joined by '|':
//   keypair: d | Q                      public_from_secret(d) == Q
//   pkv:     Q | v-or-i                  ecdh(1, Q) is CR_OK for "v" and
//                                        CR_E_KEY for "i"
//   ecdh:    Q_peer | d | Q_own | Z      public_from_secret(d) == Q_own,
//                                        ecdh(d, Q_peer) == Z
//   wp ecdh: d | public | shared | v-or-i   "v": CR_OK and shared matches,
//                                        "i": CR_E_KEY and shared wiped
//   cavp ecdsa: hash | msg | public key | sig (DER) | v-or-i   hash is 256, 384, 512
//   wp ecdsa:   hash | public key | msg | sig (DER) | v-or-i   (key before message)
// ecdsa verify is true exactly for "v".
import "crypto/core/status";
import "crypto/core/types";
import "crypto/core/util";
import "crypto/ecc/i31";
import "crypto/ecc/p384";
import "crypto/ecc/ecdsa";
import "crypto/hash/hash";
import "std/time";
import "tcheck";
import "vectors/vec_cavp_keypair_384";
import "vectors/vec_cavp_pkv_384";
import "vectors/vec_cavp_ecdh_384";
import "vectors/vec_wp_ecdh_384";
import "vectors/vec_cavp_ecdsa_384";
import "vectors/vec_wp_ecdsa_384_sha384";
import "vectors/vec_wp_ecdsa_384_sha512";

const SIG_BUF: int64 = 4300;
const MSG_BUF: int64 = 1024;

fn hash_id(name: string) -> int32 {
  if (name == "256") { return CR_HASH_SHA256; }
  if (name == "384") { return CR_HASH_SHA384; }
  if (name == "512") { return CR_HASH_SHA512; }
  return 0;
}

fn keypair_rows() {
  for r in 0..VEC_CAVP_KEYPAIR_384_N {
    var row: string = VEC_CAVP_KEYPAIR_384[r];
    var sk: CrP384Secret;
    var want: uint8[97];
    var got: uint8[97];
    var label: string = "keypair row {r}";
    var dl: int64 = tc_unhex(tc_field(row, 0), &sk.b[0], 48);
    var ql: int64 = tc_unhex(tc_field(row, 1), &want[0], 97);
    tc_ok(label + " fields", dl == 48 && ql == 97);
    tc_fill(&got[0], 97, 255);
    tc_rc(label, cr_p384_public_from_secret(&got[0], 97, &sk), CR_OK);
    tc_ok(label + " public key", cr_equal(&got[0], &want[0], 97));
    cr_wipe(&sk.b[0], 48);
  }
}

fn ecdh_rows() {
  for r in 0..VEC_CAVP_ECDH_384_N {
    var row: string = VEC_CAVP_ECDH_384[r];
    var sk: CrP384Secret;
    var peer: uint8[97];
    var own: uint8[97];
    var got: uint8[97];
    var want: uint8[48];
    var z: uint8[48];
    var label: string = "ecdh row {r}";
    var pl: int64 = tc_unhex(tc_field(row, 0), &peer[0], 97);
    var dl: int64 = tc_unhex(tc_field(row, 1), &sk.b[0], 48);
    var ol: int64 = tc_unhex(tc_field(row, 2), &own[0], 97);
    var zl: int64 = tc_unhex(tc_field(row, 3), &want[0], 48);
    tc_ok(label + " fields", pl == 97 && dl == 48 && ol == 97 && zl == 48);
    tc_rc(label + " public key", cr_p384_public_from_secret(&got[0], 97, &sk), CR_OK);
    tc_ok(label + " own public key", cr_equal(&got[0], &own[0], 97));
    tc_rc(label, cr_p384_ecdh(&z[0], 48, &sk, &peer[0], 97), CR_OK);
    tc_ok(label + " shared secret", cr_equal(&z[0], &want[0], 48));
    cr_wipe(&z[0], 48);
    cr_wipe(&sk.b[0], 48);
  }
}

fn pkv_rows() {
  var sk: CrP384Secret;
  sk.b[47] = 1;
  var valid: int32 = 0;
  for r in 0..VEC_CAVP_PKV_384_N {
    var row: string = VEC_CAVP_PKV_384[r];
    var q: uint8[130];
    var z: uint8[48];
    var label: string = "pkv row {r}";
    var ql: int64 = tc_unhex(tc_field(row, 0), &q[0], 130);
    var verdict: string = tc_field(row, 1);
    tc_ok(label + " fields", ql > 0);
    tc_fill(&z[0], 48, 170);
    if (verdict == "v") {
      valid = valid + 1;
      tc_rc(label + " valid", cr_p384_ecdh(&z[0], 48, &sk, &q[0], ql), CR_OK);
      // 1 * Q is Q itself, so the shared secret is the X coordinate.
      tc_ok(label + " shared is X", ql == 97 && cr_equal(&z[0], &q[1], 48));
    } else {
      tc_rc(label + " invalid", cr_p384_ecdh(&z[0], 48, &sk, &q[0], ql), CR_E_KEY);
      tc_ok(label + " shared wiped", tc_all_zero(&z[0], 48));
    }
  }
  tc_ok("pkv has valid and invalid rows", valid > 0 && valid < VEC_CAVP_PKV_384_N);
  cr_wipe(&sk.b[0], 48);
}

fn wycheproof_ecdh_rows() {
  var valid: int32 = 0;
  for r in 0..VEC_WP_ECDH_384_N {
    var row: string = VEC_WP_ECDH_384[r];
    var sk: CrP384Secret;
    var pub: uint8[200];
    var want: uint8[48];
    var z: uint8[48];
    var label: string = "wycheproof ecdh row {r}";
    var dl: int64 = tc_unhex(tc_field(row, 0), &sk.b[0], 48);
    var pl: int64 = tc_unhex(tc_field(row, 1), &pub[0], 200);
    var wl: int64 = tc_unhex(tc_field(row, 2), &want[0], 48);
    var verdict: string = tc_field(row, 3);
    tc_ok(label + " fields", dl == 48 && pl >= 0 && wl >= 0);
    tc_fill(&z[0], 48, 170);
    if (verdict == "v") {
      valid = valid + 1;
      tc_rc(label, cr_p384_ecdh(&z[0], 48, &sk, &pub[0], pl), CR_OK);
      tc_ok(label + " shared secret", wl == 48 && cr_equal(&z[0], &want[0], 48));
    } else {
      tc_rc(label + " (invalid)", cr_p384_ecdh(&z[0], 48, &sk, &pub[0], pl), CR_E_KEY);
      tc_ok(label + " shared wiped", tc_all_zero(&z[0], 48));
    }
    cr_wipe(&sk.b[0], 48);
  }
  tc_ok("wycheproof ecdh has valid and invalid rows", valid > 0 && valid < VEC_WP_ECDH_384_N);
}

fn cavp_ecdsa_rows() {
  var msg: uint8[1024];
  var pk: uint8[130];
  var sig: uint8[4300];
  var valid: int32 = 0;
  for r in 0..VEC_CAVP_ECDSA_384_N {
    var row: string = VEC_CAVP_ECDSA_384[r];
    var label: string = "cavp ecdsa row {r}";
    var h: int32 = hash_id(tc_field(row, 0));
    var ml: int64 = tc_unhex(tc_field(row, 1), &msg[0], MSG_BUF);
    var pl: int64 = tc_unhex(tc_field(row, 2), &pk[0], 130);
    var sl: int64 = tc_unhex(tc_field(row, 3), &sig[0], SIG_BUF);
    var verdict: string = tc_field(row, 4);
    tc_ok(label + " fields", h != 0 && ml >= 0 && pl == 97 && sl > 0);
    var got: bool = cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], ml, h, &pk[0], pl);
    tc_ok(label + " verdict " + verdict, got == (verdict == "v"));
    if (verdict == "v") { valid = valid + 1; }
  }
  tc_ok("cavp ecdsa has valid and invalid rows", valid > 0 && valid < VEC_CAVP_ECDSA_384_N);
}

fn wp_ecdsa_rows(rows: string*, count: int32, name: string) {
  var msg: uint8[1024];
  var pk: uint8[130];
  var sig: uint8[4300];
  var valid: int32 = 0;
  for r in 0..count {
    var row: string = rows[r];
    var label: string = name + " row {r}";
    var h: int32 = hash_id(tc_field(row, 0));
    var pl: int64 = tc_unhex(tc_field(row, 1), &pk[0], 130);
    var ml: int64 = tc_unhex(tc_field(row, 2), &msg[0], MSG_BUF);
    var sl: int64 = tc_unhex(tc_field(row, 3), &sig[0], SIG_BUF);
    var verdict: string = tc_field(row, 4);
    tc_ok(label + " fields", h != 0 && ml >= 0 && pl >= 0 && sl >= 0);
    var got: bool = cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], ml, h, &pk[0], pl);
    tc_ok(label + " verdict " + verdict, got == (verdict == "v"));
    if (verdict == "v") { valid = valid + 1; }
  }
  tc_ok(name + " has valid and invalid rows", valid > 0 && valid < count);
}

// RFC 6979 appendix A.2.6 (P-384).
fn rfc6979() {
  var sk: CrP384Secret;
  var pk: uint8[97];
  var sig: uint8[104];
  var sl: int64 = 0;
  tc_unhex("6b9d3dad2e1b8c1c05b19875b6659f4de23c3b667bf297ba9aa47740787137d896d5724e4c70a825f872c9ea60d2edf5", &sk.b[0], 48);
  tc_rc("rfc6979 public key", cr_p384_public_from_secret(&pk[0], 97, &sk), CR_OK);

  var msgs: string[6] = ["sample", "sample", "sample", "test", "test", "test"];
  var hashes: int32[6] = [CR_HASH_SHA256, CR_HASH_SHA384, CR_HASH_SHA512, CR_HASH_SHA256, CR_HASH_SHA384, CR_HASH_SHA512];
  var want: string[6] = [
    "3065023021b13d1e013c7fa1392d03c5f99af8b30c570c6f98d4ea8e354b63a21d3daa33bde1e888e63355d92fa2b3c36d8fb2cd023100f3aa443fb107745bf4bd77cb3891674632068a10ca67e3d45db2266fa7d1feebefdc63eccd1ac42ec0cb8668a4fa0ab0",
    "306602310094edbb92a5ecb8aad4736e56c691916b3f88140666ce9fa73d64c4ea95ad133c81a648152e44acf96e36dd1e80fabe4602310099ef4aeb15f178cea1fe40db2603138f130e740a19624526203b6351d0a3a94fa329c145786e679e7b82c71a38628ac8",
    "3065023100ed0959d5880ab2d869ae7f6c2915c6d60f96507f9cb3e047c0046861da4a799cfe30f35cc900056d7c99cd78824337090230512c8cceee3890a84058ce1e22dbc2198f42323ce8aca9135329f03c068e5112dc7cc3ef3446defceb01a45c2667fdd5",
    "306402306d6defac9ab64dabafe36c6bf510352a4cc27001263638e5b16d9bb51d451559f918eedaf2293be5b475cc8f0188636b02302d46f3becbcc523d5f1a1256bf0c9b024d879ba9e838144c8ba6baeb4b53b47d51ab373f9845c0514eefb14024787265",
    "30660231008203b63d3c853e8d77227fb377bcf7b7b772e97892a80f36ab775d509d7a5feb0542a7f0812998da8f1dd3ca3cf023db023100ddd0760448d42d8a43af45af836fce4de8be06b485e9b61b827c2f13173923e06a739f040649a667bf3b828246baa5a5",
    "3066023100a0d5d090c9980faf3c2ce57b7ae951d31977dd11c775d314af55f76c676447d06fb6495cd21b4b6e340fc236584fb277023100976984e59b4c77b0e8e4460dca3d9f20e07b9bb1f63beefaf576f6b2e8b224634a2092cd3792e0159ad9cee37659c736"
  ];
  for i in 0..6 {
    var label: string = "rfc6979 {msgs[i]} hash {hashes[i]}";
    sl = -1;
    tc_rc(label, cr_p384_ecdsa_sign(&sig[0], 104, &sl, msgs[i].chars, (int64)msgs[i].length, hashes[i], &sk), CR_OK);
    tc_hex_eq(label + " signature", &sig[0], sl, want[i]);
    tc_ok(label + " verifies", cr_p384_ecdsa_verify(&sig[0], sl, msgs[i].chars, (int64)msgs[i].length, hashes[i], &pk[0], 97));
    // The same signature, with exactly the capacity it needs.
    var again: uint8[104];
    var sl2: int64 = 0;
    tc_rc(label + " exact capacity", cr_p384_ecdsa_sign(&again[0], sl, &sl2, msgs[i].chars, (int64)msgs[i].length, hashes[i], &sk), CR_OK);
    tc_ok(label + " deterministic", sl2 == sl && cr_equal(&again[0], &sig[0], sl));
    // Another hash does not verify.
    var other: int32 = CR_HASH_SHA256;
    if (hashes[i] == CR_HASH_SHA256) { other = CR_HASH_SHA512; }
    tc_ok(label + " other hash fails", !cr_p384_ecdsa_verify(&sig[0], sl, msgs[i].chars, (int64)msgs[i].length, other, &pk[0], 97));
  }
  cr_wipe(&sk.b[0], 48);
}

fn tc_all_bytes(p: uint8*, n: int64, v: uint8) -> bool {
  for i in 0..n {
    if (p[i] != v) { return false; }
  }
  return true;
}

fn flip_bit(m: uint8*, bit: int64) {
  m[bit >> 3] = m[bit >> 3] ^ (uint8)(1 << (int32)(bit & 7));
}

// Fresh key pairs: the public key matches the secret, the secret is in range,
// two sides agree on the ECDH secret, and nothing repeats.
fn key_round_trips() {
  var seen: uint8[97];
  var n: uint8[48];
  crx_p384_order(&n[0]);
  for r in 0..6 {
    var label: string = "key round trip {r}";
    var ska: CrP384Secret;
    var skb: CrP384Secret;
    var pka: uint8[97];
    var pkb: uint8[97];
    var again: uint8[97];
    var za: uint8[48];
    var zb: uint8[48];
    tc_rc(label + " keypair a", cr_p384_keypair(&pka[0], 97, &ska), CR_OK);
    tc_rc(label + " keypair b", cr_p384_keypair(&pkb[0], 97, &skb), CR_OK);
    tc_ok(label + " format", pka[0] == 4 && pkb[0] == 4);
    tc_rc(label + " public from secret", cr_p384_public_from_secret(&again[0], 97, &ska), CR_OK);
    tc_ok(label + " same public key", cr_equal(&again[0], &pka[0], 97));
    tc_ok(label + " keys differ", !cr_equal(&pka[0], &pkb[0], 97) && !cr_equal(&ska.b[0], &skb.b[0], 48));
    tc_ok(label + " secret not zero", !tc_all_zero(&ska.b[0], 48));
    tc_ok(label + " fresh", r == 0 || !cr_equal(&pka[0], &seen[0], 97));
    for i in 0..97 { seen[i] = pka[i]; }
    tc_rc(label + " ecdh a", cr_p384_ecdh(&za[0], 48, &ska, &pkb[0], 97), CR_OK);
    tc_rc(label + " ecdh b", cr_p384_ecdh(&zb[0], 48, &skb, &pka[0], 97), CR_OK);
    tc_ok(label + " both sides agree", cr_equal(&za[0], &zb[0], 48));
    tc_ok(label + " secret not zero", !tc_all_zero(&za[0], 48));
    cr_wipe(&ska.b[0], 48);
    cr_wipe(&skb.b[0], 48);
    cr_wipe(&za[0], 48);
    cr_wipe(&zb[0], 48);
  }
}

// Small scalars and the largest one, with every expectation derived from
// the library: 2 * G by ECDH equals the public key of 2, (n - 1) * Q has the
// X coordinate of Q.
fn scalar_edges() {
  var n: uint8[48];
  crx_p384_order(&n[0]);
  var sk1: CrP384Secret;
  var sk2: CrP384Secret;
  var skm: CrP384Secret;
  var pk1: uint8[97];
  var pk2: uint8[97];
  var pkm: uint8[97];
  var z: uint8[48];
  sk1.b[47] = 1;
  sk2.b[47] = 2;
  for i in 0..48 { skm.b[i] = n[i]; }
  skm.b[47] = skm.b[47] - 1;
  tc_rc("scalar 1 public key", cr_p384_public_from_secret(&pk1[0], 97, &sk1), CR_OK);
  tc_rc("scalar 2 public key", cr_p384_public_from_secret(&pk2[0], 97, &sk2), CR_OK);
  tc_rc("scalar n-1 public key", cr_p384_public_from_secret(&pkm[0], 97, &skm), CR_OK);
  tc_ok("n-1 public key has the X of G", cr_equal(&pkm[1], &pk1[1], 48));
  tc_ok("n-1 public key has another Y", !cr_equal(&pkm[49], &pk1[49], 48));
  tc_rc("2 * G by ecdh", cr_p384_ecdh(&z[0], 48, &sk2, &pk1[0], 97), CR_OK);
  tc_ok("2 * G is the X of the public key of 2", cr_equal(&z[0], &pk2[1], 48));
  tc_rc("(n-1) * Q by ecdh", cr_p384_ecdh(&z[0], 48, &skm, &pk2[0], 97), CR_OK);
  tc_ok("(n-1) * Q has the X of Q", cr_equal(&z[0], &pk2[1], 48));
  tc_rc("1 * Q by ecdh", cr_p384_ecdh(&z[0], 48, &sk1, &pk2[0], 97), CR_OK);
  tc_ok("1 * Q has the X of Q", cr_equal(&z[0], &pk2[1], 48));

  // Scalars that are refused: 0, n, n + 1, 2^384 - 1.
  var names: string[4] = ["0", "n", "n+1", "2^384-1"];
  for i in 0..4 {
    var bad: CrP384Secret;
    var pk: uint8[97];
    var label: string = "bad scalar {names[i]}";
    if (i == 1 || i == 2) {
      for j in 0..48 { bad.b[j] = n[j]; }
    }
    if (i == 2) { bad.b[47] = bad.b[47] + 1; }
    if (i == 3) { tc_fill(&bad.b[0], 48, 255); }
    tc_fill(&pk[0], 97, 170);
    tc_fill(&z[0], 48, 170);
    tc_rc(label + " public key", cr_p384_public_from_secret(&pk[0], 97, &bad), CR_E_KEY);
    tc_ok(label + " public key wiped", tc_all_zero(&pk[0], 97));
    tc_rc(label + " ecdh", cr_p384_ecdh(&z[0], 48, &bad, &pk1[0], 97), CR_E_KEY);
    tc_ok(label + " shared wiped", tc_all_zero(&z[0], 48));
    var sig: uint8[104];
    var sl: int64 = 99;
    tc_rc(label + " sign", cr_p384_ecdsa_sign(&sig[0], 104, &sl, &pk1[0], 1, CR_HASH_SHA384, &bad), CR_E_KEY);
    tc_ok(label + " sign length 0", sl == 0);
  }
  cr_wipe(&sk1.b[0], 48);
  cr_wipe(&sk2.b[0], 48);
  cr_wipe(&skm.b[0], 48);
}

// Public keys that ECDH must refuse.
fn peer_forms() {
  var sk: CrP384Secret;
  var pk: uint8[130];
  var q: uint8[130];
  var z: uint8[60];
  var n: uint8[48];
  crx_p384_order(&n[0]);
  sk.b[47] = 7;
  var sk3: CrP384Secret;
  sk3.b[47] = 3;
  cr_p384_public_from_secret(&pk[0], 97, &sk3);
  tc_rc("peer: good", cr_p384_ecdh(&z[0], 60, &sk, &pk[0], 97), CR_OK);
  var good: uint8[48];
  for i in 0..48 { good[i] = z[i]; }

  for i in 0..97 { q[i] = pk[i]; }
  tc_fill(&z[0], 60, 170);
  tc_rc("peer: length 96", cr_p384_ecdh(&z[0], 60, &sk, &q[0], 96), CR_E_KEY);
  tc_ok("peer: length 96 wiped, tail untouched", tc_all_zero(&z[0], 48) && z[48] == 170 && z[59] == 170);
  tc_rc("peer: length 98", cr_p384_ecdh(&z[0], 60, &sk, &q[0], 98), CR_E_KEY);
  tc_rc("peer: length 0", cr_p384_ecdh(&z[0], 60, &sk, &q[0], 0), CR_E_KEY);
  q[0] = 2;
  tc_rc("peer: compressed tag", cr_p384_ecdh(&z[0], 60, &sk, &q[0], 97), CR_E_KEY);
  q[0] = 6;
  tc_rc("peer: hybrid tag", cr_p384_ecdh(&z[0], 60, &sk, &q[0], 97), CR_E_KEY);
  q[0] = 0;
  tc_rc("peer: zero tag", cr_p384_ecdh(&z[0], 60, &sk, &q[0], 97), CR_E_KEY);
  q[0] = 4;
  q[96] = q[96] ^ 1;
  tc_rc("peer: off the curve", cr_p384_ecdh(&z[0], 60, &sk, &q[0], 97), CR_E_KEY);
  q[96] = q[96] ^ 1;
  q[1] = q[1] ^ 0x80;
  tc_rc("peer: X changed", cr_p384_ecdh(&z[0], 60, &sk, &q[0], 97), CR_E_KEY);
  q[1] = q[1] ^ 0x80;
  for i in 0..97 { q[i] = 0; }
  q[0] = 4;
  tc_rc("peer: point (0, 0)", cr_p384_ecdh(&z[0], 60, &sk, &q[0], 97), CR_E_KEY);
  for i in 1..97 { q[i] = 255; }
  tc_rc("peer: coordinates above the prime", cr_p384_ecdh(&z[0], 60, &sk, &q[0], 97), CR_E_KEY);
  tc_ok("peer: still wiped after errors", tc_all_zero(&z[0], 48));
  for i in 0..97 { q[i] = pk[i]; }
  tc_rc("peer: good again", cr_p384_ecdh(&z[0], 60, &sk, &q[0], 97), CR_OK);
  tc_ok("peer: same result", cr_equal(&z[0], &good[0], 48));
  cr_wipe(&sk.b[0], 48);
  cr_wipe(&sk3.b[0], 48);
}

fn argument_errors() {
  var sk: CrP384Secret;
  var pk: uint8[100];
  var z: uint8[60];
  sk.b[47] = 5;
  tc_ok("size constant", CR_P384_PUBLIC_BYTES == 97 && CR_P384_ECDSA_SIG_MAX == 104);

  tc_rc("keypair null pk", cr_p384_keypair(0, 97, &sk), CR_E_ARG);
  tc_rc("keypair null sk", cr_p384_keypair(&pk[0], 97, 0), CR_E_ARG);
  tc_rc("keypair negative cap", cr_p384_keypair(&pk[0], -1, &sk), CR_E_ARG);
  tc_fill(&pk[0], 100, 7);
  tc_rc("keypair small cap", cr_p384_keypair(&pk[0], 96, &sk), CR_E_SPACE);
  tc_ok("keypair small cap: nothing written", tc_all_bytes(&pk[0], 100, (uint8)7));
  tc_fill(&pk[0], 100, 7);
  tc_rc("keypair exact cap", cr_p384_keypair(&pk[0], 97, &sk), CR_OK);
  tc_ok("keypair exact cap: no overrun", pk[97] == 7 && pk[99] == 7 && pk[0] == 4);

  sk.b[47] = 5;
  tc_rc("public null pk", cr_p384_public_from_secret(0, 97, &sk), CR_E_ARG);
  tc_rc("public null sk", cr_p384_public_from_secret(&pk[0], 97, 0), CR_E_ARG);
  tc_rc("public negative cap", cr_p384_public_from_secret(&pk[0], -1, &sk), CR_E_ARG);
  tc_fill(&pk[0], 100, 7);
  tc_rc("public small cap", cr_p384_public_from_secret(&pk[0], 96, &sk), CR_E_SPACE);
  tc_ok("public small cap: nothing written", tc_all_bytes(&pk[0], 100, (uint8)7));
  tc_rc("public", cr_p384_public_from_secret(&pk[0], 100, &sk), CR_OK);

  tc_rc("ecdh null shared", cr_p384_ecdh(0, 48, &sk, &pk[0], 97), CR_E_ARG);
  tc_rc("ecdh null sk", cr_p384_ecdh(&z[0], 48, 0, &pk[0], 97), CR_E_ARG);
  tc_rc("ecdh null peer", cr_p384_ecdh(&z[0], 48, &sk, 0, 97), CR_E_ARG);
  tc_rc("ecdh negative peer length", cr_p384_ecdh(&z[0], 48, &sk, &pk[0], -1), CR_E_ARG);
  tc_rc("ecdh negative capacity", cr_p384_ecdh(&z[0], -1, &sk, &pk[0], 97), CR_E_ARG);
  tc_fill(&z[0], 60, 7);
  tc_rc("ecdh small capacity", cr_p384_ecdh(&z[0], 47, &sk, &pk[0], 97), CR_E_SPACE);
  tc_ok("ecdh small capacity: nothing written", tc_all_bytes(&z[0], 60, (uint8)7));
  tc_rc("ecdh null peer, length 0", cr_p384_ecdh(&z[0], 48, &sk, 0, 0), CR_E_KEY);
  tc_fill(&z[0], 60, 7);
  tc_rc("ecdh larger capacity", cr_p384_ecdh(&z[0], 60, &sk, &pk[0], 97), CR_OK);
  tc_ok("ecdh larger capacity: tail untouched", z[48] == 7 && z[59] == 7);
  cr_wipe(&sk.b[0], 48);
}

// n - s as a 48-byte big-endian number, for the "high s" twin of a signature.
fn order_minus(out: uint8*, s: uint8*) {
  var n: uint8[48];
  crx_p384_order(&n[0]);
  var borrow: int32 = 0;
  var i: int32 = 47;
  while (i >= 0) {
    var d: int32 = (int32)n[i] - (int32)s[i] - borrow;
    borrow = 0;
    if (d < 0) { d = d + 256; borrow = 1; }
    out[i] = (uint8)d;
    i = i - 1;
  }
}

fn der_from_raw(out: uint8*, r: uint8*, s: uint8*) -> int64 {
  var raw: uint8[112];
  for i in 0..48 { raw[i] = r[i]; raw[48 + i] = s[i]; }
  var dl: int64 = crx_ecdsa_raw_to_asn1(&raw[0], 96);
  for i in 0..dl { out[i] = raw[i]; }
  return dl;
}

// Random keys, all three hashes, empty and long messages, then tampering.
fn sign_round_trips() {
  var hs: int32[3] = [CR_HASH_SHA256, CR_HASH_SHA384, CR_HASH_SHA512];
  var long_msg: uint8[300];
  for i in 0..300 { long_msg[i] = (uint8)(i * 7 + 3); }
  for r in 0..3 {
    var sk: CrP384Secret;
    var pk: uint8[97];
    var label: string = "sign round trip {r}";
    tc_rc(label + " keypair", cr_p384_keypair(&pk[0], 97, &sk), CR_OK);
    for j in 0..3 {
      var h: int32 = hs[j];
      var l2: string = label + " hash {h}";
      var sig: uint8[104];
      var sl: int64 = 0;
      var msg: uint8[300];
      var ml: int64 = (int64)((r * 101 + j * 37) % 300);
      for i in 0..300 { msg[i] = long_msg[i]; }
      tc_rc(l2 + " sign", cr_p384_ecdsa_sign(&sig[0], 104, &sl, &msg[0], ml, h, &sk), CR_OK);
      tc_ok(l2 + " length", sl >= 8 && sl <= CR_P384_ECDSA_SIG_MAX);
      tc_ok(l2 + " verifies", cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], ml, h, &pk[0], 97));

      // Deterministic.
      var sig2: uint8[104];
      var sl2: int64 = 0;
      cr_p384_ecdsa_sign(&sig2[0], 104, &sl2, &msg[0], ml, h, &sk);
      tc_ok(l2 + " deterministic", sl2 == sl && cr_equal(&sig2[0], &sig[0], sl));

      // A flipped bit in the message fails (a few bits across the message).
      if (ml > 0) {
        var bad: bool = false;
        for b in 0..6 {
          var bit: int64 = (b * (ml * 8)) / 6;
          flip_bit(&msg[0], bit);
          if (cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], ml, h, &pk[0], 97)) { bad = true; }
          flip_bit(&msg[0], bit);
        }
        tc_ok(l2 + " message bit flips fail", !bad);
        tc_ok(l2 + " truncated message fails", !cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], ml - 1, h, &pk[0], 97));
      }
      tc_ok(l2 + " extended message fails", !cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], ml + 1, h, &pk[0], 97));

      // A flipped bit in the signature fails (bits across the signature).
      var badsig: bool = false;
      for b in 0..12 {
        var bit: int64 = (b * (sl * 8)) / 12;
        flip_bit(&sig[0], bit);
        if (cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], ml, h, &pk[0], 97)) { badsig = true; }
        flip_bit(&sig[0], bit);
      }
      tc_ok(l2 + " signature bit flips fail", !badsig);
      tc_ok(l2 + " still verifies", cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], ml, h, &pk[0], 97));

      // Another key fails.
      var sk2: CrP384Secret;
      var pk2: uint8[97];
      cr_p384_keypair(&pk2[0], 97, &sk2);
      tc_ok(l2 + " other key fails", !cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], ml, h, &pk2[0], 97));
      cr_wipe(&sk2.b[0], 48);
    }
    cr_wipe(&sk.b[0], 48);
  }
}

// Signatures that must or must not be accepted.
fn signature_forms() {
  var sk: CrP384Secret;
  var pk: uint8[97];
  var sig: uint8[104];
  var sl: int64 = 0;
  var msg: uint8[5];
  msg[0] = (uint8)'h'; msg[1] = (uint8)'e'; msg[2] = (uint8)'l'; msg[3] = (uint8)'l'; msg[4] = (uint8)'o';
  tc_unhex("6b9d3dad2e1b8c1c05b19875b6659f4de23c3b667bf297ba9aa47740787137d896d5724e4c70a825f872c9ea60d2edf5", &sk.b[0], 48);
  cr_p384_public_from_secret(&pk[0], 97, &sk);
  cr_p384_ecdsa_sign(&sig[0], 104, &sl, &msg[0], 5, CR_HASH_SHA384, &sk);
  tc_ok("form: base signature", cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], 5, CR_HASH_SHA384, &pk[0], 97));

  // Raw r and s of the base signature.
  var raw: uint8[112];
  for i in 0..sl { raw[i] = sig[i]; }
  var rl: int64 = crx_ecdsa_asn1_to_raw(&raw[0], sl);
  tc_ok("form: atr gives 96 bytes", rl == 96);
  var r: uint8[48];
  var s: uint8[48];
  for i in 0..48 { r[i] = raw[i]; s[i] = raw[48 + i]; }

  // The high-s twin (r, n - s) is also a valid ECDSA signature.
  var s2: uint8[48];
  var tw: uint8[112];
  order_minus(&s2[0], &s[0]);
  var tl: int64 = der_from_raw(&tw[0], &r[0], &s2[0]);
  tc_ok("form: twin signature verifies", cr_p384_ecdsa_verify(&tw[0], tl, &msg[0], 5, CR_HASH_SHA384, &pk[0], 97));

  // Trailing byte, missing byte, wrong tag, long-form length, extra zero in r.
  var t: uint8[112];
  for i in 0..sl { t[i] = sig[i]; }
  t[sl] = 0;
  tc_ok("form: trailing byte fails", !cr_p384_ecdsa_verify(&t[0], sl + 1, &msg[0], 5, CR_HASH_SHA384, &pk[0], 97));
  tc_ok("form: missing byte fails", !cr_p384_ecdsa_verify(&sig[0], sl - 1, &msg[0], 5, CR_HASH_SHA384, &pk[0], 97));
  for i in 0..sl { t[i] = sig[i]; }
  t[0] = 0x31;
  tc_ok("form: SET tag fails", !cr_p384_ecdsa_verify(&t[0], sl, &msg[0], 5, CR_HASH_SHA384, &pk[0], 97));
  t[0] = 0x30;
  t[2] = 0x03;
  tc_ok("form: wrong integer tag fails", !cr_p384_ecdsa_verify(&t[0], sl, &msg[0], 5, CR_HASH_SHA384, &pk[0], 97));

  // 30 81 LL ...: a valid value in BER long form.
  t[0] = 0x30;
  t[1] = 0x81;
  t[2] = (uint8)(sl - 2);
  for i in 2..sl { t[i + 1] = sig[i]; }
  tc_ok("form: long-form length fails", !cr_p384_ecdsa_verify(&t[0], sl + 1, &msg[0], 5, CR_HASH_SHA384, &pk[0], 97));

  // An extra leading zero in the integer r (not minimal).
  t[0] = 0x30;
  t[1] = (uint8)(sl - 2 + 1);
  t[2] = 0x02;
  t[3] = (uint8)(sig[3] + 1);
  t[4] = 0x00;
  for i in 4..sl { t[i + 1] = sig[i]; }
  tc_ok("form: padded integer fails", !cr_p384_ecdsa_verify(&t[0], sl + 1, &msg[0], 5, CR_HASH_SHA384, &pk[0], 97));

  // r or s equal to 0, to n, or above n.
  var zero: uint8[48];
  var one: uint8[48];
  var n: uint8[48];
  var n1: uint8[48];
  var big: uint8[48];
  one[47] = 1;
  crx_p384_order(&n[0]);
  crx_p384_order(&n1[0]);
  n1[47] = n1[47] + 1;
  for i in 0..48 { big[i] = 255; }
  var names: string[4] = ["0", "n", "n+1", "2^384-1"];
  for i in 0..4 {
    var v: uint8[48];
    var d: uint8[112];
    if (i == 0) { for j in 0..48 { v[j] = zero[j]; } }
    if (i == 1) { for j in 0..48 { v[j] = n[j]; } }
    if (i == 2) { for j in 0..48 { v[j] = n1[j]; } }
    if (i == 3) { for j in 0..48 { v[j] = big[j]; } }
    var dl: int64 = der_from_raw(&d[0], &v[0], &s[0]);
    tc_ok("form: r = {names[i]} fails", !cr_p384_ecdsa_verify(&d[0], dl, &msg[0], 5, CR_HASH_SHA384, &pk[0], 97));
    dl = der_from_raw(&d[0], &r[0], &v[0]);
    tc_ok("form: s = {names[i]} fails", !cr_p384_ecdsa_verify(&d[0], dl, &msg[0], 5, CR_HASH_SHA384, &pk[0], 97));
  }
  var d2: uint8[112];
  var dl2: int64 = der_from_raw(&d2[0], &one[0], &one[0]);
  tc_ok("form: r = s = 1 fails", !cr_p384_ecdsa_verify(&d2[0], dl2, &msg[0], 5, CR_HASH_SHA384, &pk[0], 97));
  dl2 = der_from_raw(&d2[0], &zero[0], &zero[0]);
  tc_ok("form: r = s = 0 fails", !cr_p384_ecdsa_verify(&d2[0], dl2, &msg[0], 5, CR_HASH_SHA384, &pk[0], 97));

  // Empty and tiny signatures, and one far too long.
  tc_ok("form: empty fails", !cr_p384_ecdsa_verify(&sig[0], 0, &msg[0], 5, CR_HASH_SHA384, &pk[0], 97));
  tc_ok("form: 7 bytes fails", !cr_p384_ecdsa_verify(&sig[0], 7, &msg[0], 5, CR_HASH_SHA384, &pk[0], 97));
  tc_ok("form: 100000 bytes fails", !cr_p384_ecdsa_verify(&sig[0], 100000, &msg[0], 5, CR_HASH_SHA384, &pk[0], 97));
  cr_wipe(&sk.b[0], 48);
}

// Public keys that ECDSA verification must refuse.
fn key_forms() {
  var sk: CrP384Secret;
  var pk: uint8[100];
  var sig: uint8[104];
  var sl: int64 = 0;
  var msg: uint8[3];
  msg[0] = 1; msg[1] = 2; msg[2] = 3;
  sk.b[47] = 9;
  cr_p384_public_from_secret(&pk[0], 97, &sk);
  cr_p384_ecdsa_sign(&sig[0], 104, &sl, &msg[0], 3, CR_HASH_SHA256, &sk);
  tc_ok("key: good", cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], 3, CR_HASH_SHA256, &pk[0], 97));
  tc_ok("key: length 96", !cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], 3, CR_HASH_SHA256, &pk[0], 96));
  tc_ok("key: length 98", !cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], 3, CR_HASH_SHA256, &pk[0], 98));
  tc_ok("key: length 0", !cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], 3, CR_HASH_SHA256, &pk[0], 0));
  tc_ok("key: null", !cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], 3, CR_HASH_SHA256, 0, 97));
  var q: uint8[100];
  for i in 0..97 { q[i] = pk[i]; }
  q[0] = 2;
  tc_ok("key: compressed tag", !cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], 3, CR_HASH_SHA256, &q[0], 97));
  q[0] = 6;
  tc_ok("key: hybrid tag", !cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], 3, CR_HASH_SHA256, &q[0], 97));
  q[0] = 4;
  q[96] = q[96] ^ 1;
  tc_ok("key: off the curve", !cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], 3, CR_HASH_SHA256, &q[0], 97));
  for i in 0..97 { q[i] = 0; }
  q[0] = 4;
  tc_ok("key: point (0, 0)", !cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], 3, CR_HASH_SHA256, &q[0], 97));
  cr_wipe(&sk.b[0], 48);
}

fn sign_argument_errors() {
  var sk: CrP384Secret;
  var pk: uint8[97];
  var sig: uint8[112];
  var sl: int64 = 0;
  var msg: uint8[4];
  msg[0] = 9;
  sk.b[47] = 11;
  cr_p384_public_from_secret(&pk[0], 97, &sk);

  // Bad hash ids.
  var bad: int32[5] = [0, 4, -1, 100, 65537];
  for i in 0..5 {
    sl = 99;
    tc_fill(&sig[0], 112, 7);
    tc_rc("hash id {bad[i]}: sign", cr_p384_ecdsa_sign(&sig[0], 104, &sl, &msg[0], 1, bad[i], &sk), CR_E_ARG);
    tc_ok("hash id {bad[i]}: nothing written", sl == 0 && sig[0] == 7 && sig[103] == 7);
  }
  cr_p384_ecdsa_sign(&sig[0], 104, &sl, &msg[0], 1, CR_HASH_SHA256, &sk);
  for i in 0..5 {
    tc_ok("hash id {bad[i]}: verify", !cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], 1, bad[i], &pk[0], 97));
  }

  // Null and negative arguments.
  tc_rc("sign null sig", cr_p384_ecdsa_sign(0, 104, &sl, &msg[0], 1, CR_HASH_SHA256, &sk), CR_E_ARG);
  tc_rc("sign null sig_len", cr_p384_ecdsa_sign(&sig[0], 104, 0, &msg[0], 1, CR_HASH_SHA256, &sk), CR_E_ARG);
  tc_rc("sign null key", cr_p384_ecdsa_sign(&sig[0], 104, &sl, &msg[0], 1, CR_HASH_SHA256, 0), CR_E_ARG);
  tc_rc("sign null msg", cr_p384_ecdsa_sign(&sig[0], 104, &sl, 0, 1, CR_HASH_SHA256, &sk), CR_E_ARG);
  tc_rc("sign negative length", cr_p384_ecdsa_sign(&sig[0], 104, &sl, &msg[0], -1, CR_HASH_SHA256, &sk), CR_E_ARG);
  tc_rc("sign negative capacity", cr_p384_ecdsa_sign(&sig[0], -1, &sl, &msg[0], 1, CR_HASH_SHA256, &sk), CR_E_ARG);
  tc_ok("sign errors leave length 0", sl == 0);
  tc_rc("sign empty message, null pointer", cr_p384_ecdsa_sign(&sig[0], 104, &sl, 0, 0, CR_HASH_SHA256, &sk), CR_OK);
  tc_ok("empty message (null) verifies", cr_p384_ecdsa_verify(&sig[0], sl, 0, 0, CR_HASH_SHA256, &pk[0], 97));
  tc_ok("empty message (pointer) verifies", cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], 0, CR_HASH_SHA256, &pk[0], 97));
  tc_ok("verify null sig", !cr_p384_ecdsa_verify(0, 100, &msg[0], 1, CR_HASH_SHA256, &pk[0], 97));
  tc_ok("verify null msg", !cr_p384_ecdsa_verify(&sig[0], sl, 0, 1, CR_HASH_SHA256, &pk[0], 97));
  tc_ok("verify negative msg length", !cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], -1, CR_HASH_SHA256, &pk[0], 97));
  tc_ok("verify negative sig length", !cr_p384_ecdsa_verify(&sig[0], -1, &msg[0], 1, CR_HASH_SHA256, &pk[0], 97));

  // Capacity: nothing is written below the DER length.
  var dl: int64 = 0;
  tc_rc("sign for length", cr_p384_ecdsa_sign(&sig[0], 104, &dl, &msg[0], 1, CR_HASH_SHA256, &sk), CR_OK);
  for cap in 0..dl {
    tc_fill(&sig[0], 112, 7);
    sl = 99;
    tc_rc("capacity {cap}", cr_p384_ecdsa_sign(&sig[0], cap, &sl, &msg[0], 1, CR_HASH_SHA256, &sk), CR_E_SPACE);
    tc_ok("capacity {cap}: nothing written", sl == 0 && tc_all_bytes(&sig[0], 112, (uint8)7));
  }
  tc_fill(&sig[0], 112, 7);
  tc_rc("capacity exact", cr_p384_ecdsa_sign(&sig[0], dl, &sl, &msg[0], 1, CR_HASH_SHA256, &sk), CR_OK);
  tc_ok("capacity exact: length and no overrun", sl == dl && sig[dl] == 7 && sig[111] == 7);
  cr_wipe(&sk.b[0], 48);
}

// The DER, bits2int and point routines directly.
fn internal_routines() {
  // DER and raw round trips for r and s with 0 to 2 leading zero bytes, and
  // with and without the top bit set.
  var fills: uint8[4] = [(uint8)0x01, (uint8)0x7f, (uint8)0x80, (uint8)0xff];
  for a in 0..4 {
    for b in 0..4 {
      for za in 0..3 {
        for zb in 0..3 {
          var raw: uint8[112];
          var keep: uint8[96];
          for i in 0..48 {
            raw[i] = fills[a];
            raw[48 + i] = fills[b];
            if (i < za) { raw[i] = 0; }
            if (i < zb) { raw[48 + i] = 0; }
          }
          for i in 0..96 { keep[i] = raw[i]; }
          var label: string = "der {a} {b} {za} {zb}";
          var dl: int64 = crx_ecdsa_raw_to_asn1(&raw[0], 96);
          tc_ok(label + " encodes", dl >= 8 && dl <= 104 && raw[0] == 0x30 && (int64)raw[1] == dl - 2);
          var rl: int64 = crx_ecdsa_asn1_to_raw(&raw[0], dl);
          var zl: int64 = 48 - (int64)za;
          if (zb < za) { zl = 48 - (int64)zb; }
          tc_ok(label + " decodes", rl == 2 * zl && cr_equal(&raw[0], &keep[48 - zl], zl) && cr_equal(&raw[zl], &keep[96 - zl], zl));
        }
      }
    }
  }
  // Largest DER: both integers padded.
  var wide: uint8[112];
  tc_fill(&wide[0], 96, 255);
  tc_ok("widest DER is 104 bytes", crx_ecdsa_raw_to_asn1(&wide[0], 96) == CR_P384_ECDSA_SIG_MAX);

  // bits2int against the order's encoded bit length (396).
  var n: uint32[16];
  var nb: uint8[48];
  crx_p384_order(&nb[0]);
  crx_i31_decode(&n[0], &nb[0], 48);
  tc_ok("order has 384 bits", n[0] == 396);
  var src: uint8[64];
  for i in 0..64 { src[i] = (uint8)(i * 5 + 1); }
  var x: uint32[16];
  var out: uint8[48];
  crx_ecdsa_bits2int(&x[0], &src[0], 48, n[0]);
  crx_i31_encode(&out[0], 48, &x[0]);
  tc_ok("bits2int 48 bytes is the input", x[0] == 396 && cr_equal(&out[0], &src[0], 48));
  crx_ecdsa_bits2int(&x[0], &src[0], 64, n[0]);
  crx_i31_encode(&out[0], 48, &x[0]);
  tc_ok("bits2int 64 bytes keeps the leftmost 384 bits", cr_equal(&out[0], &src[0], 48));
  crx_ecdsa_bits2int(&x[0], &src[0], 32, n[0]);
  crx_i31_encode(&out[0], 48, &x[0]);
  var padded: bool = true;
  for i in 0..16 { if (out[i] != 0) { padded = false; } }
  for i in 0..32 { if (out[16 + i] != src[i]) { padded = false; } }
  tc_ok("bits2int 32 bytes is left-padded", padded);

  // The point routines. Scalars 1, 2, 3, 5, 11 and n-1, all derived from the
  // library itself.
  var sk: CrP384Secret;
  var g: uint8[97];
  var p2: uint8[97];
  var p3: uint8[97];
  var p11: uint8[97];
  var a: uint8[97];
  var b: uint8[97];
  var sc: uint8[48];
  var sc2: uint8[48];
  var nm1: uint8[48];
  sk.b[47] = 1;
  cr_p384_public_from_secret(&g[0], 97, &sk);
  sk.b[47] = 2;
  cr_p384_public_from_secret(&p2[0], 97, &sk);
  sk.b[47] = 3;
  cr_p384_public_from_secret(&p3[0], 97, &sk);
  sk.b[47] = 11;
  cr_p384_public_from_secret(&p11[0], 97, &sk);
  for i in 0..48 { nm1[i] = nb[i]; }
  nm1[47] = nm1[47] - 1;
  sc[47] = 1;

  // G + G takes the doubling path; G + (n-1) G is the point at infinity.
  for i in 0..97 { a[i] = g[i]; }
  tc_ok("muladd 1*G + 1*G", crx_p384_muladd(&a[0], 0, 97, &sc[0], 48, &sc[0], 48) == 1);
  tc_ok("muladd 1*G + 1*G is 2G", cr_equal(&a[0], &p2[0], 97));
  for i in 0..97 { a[i] = g[i]; }
  tc_ok("muladd 1*G + (n-1)*G fails", crx_p384_muladd(&a[0], 0, 97, &sc[0], 48, &nm1[0], 48) == 0);
  for i in 0..97 { a[i] = g[i]; }
  tc_ok("muladd (n-1)*G + 1*G fails", crx_p384_muladd(&a[0], 0, 97, &nm1[0], 48, &sc[0], 48) == 0);
  // 2 * (3G) + 5 * G = 11 G, with B explicit and implicit.
  sc[47] = 2;
  sc2[47] = 5;
  for i in 0..97 { a[i] = p3[i]; }
  tc_ok("muladd 2*(3G) + 5*G", crx_p384_muladd(&a[0], 0, 97, &sc[0], 48, &sc2[0], 48) == 1);
  tc_ok("muladd 2*(3G) + 5*G is 11G", cr_equal(&a[0], &p11[0], 97));
  for i in 0..97 { a[i] = p3[i]; }
  for i in 0..97 { b[i] = g[i]; }
  tc_ok("muladd with explicit B", crx_p384_muladd(&a[0], &b[0], 97, &sc[0], 48, &sc2[0], 48) == 1);
  tc_ok("muladd with explicit B is 11G", cr_equal(&a[0], &p11[0], 97));
  for i in 0..97 { a[i] = p3[i]; }
  a[96] = a[96] ^ 1;
  tc_ok("muladd refuses an invalid A", crx_p384_muladd(&a[0], 0, 97, &sc[0], 48, &sc2[0], 48) == 0);
  for i in 0..97 { a[i] = p3[i]; }
  tc_ok("muladd refuses a wrong length", crx_p384_muladd(&a[0], 0, 96, &sc[0], 48, &sc2[0], 48) == 0);

  // mul: 3 * (2G) is 6G by two routes; short multipliers work too.
  var p6: uint8[97];
  sk.b[47] = 6;
  cr_p384_public_from_secret(&p6[0], 97, &sk);
  for i in 0..97 { a[i] = p2[i]; }
  sc[47] = 3;
  tc_ok("mul 3*(2G)", crx_p384_mul(&a[0], 97, &sc[0], 48) == 1);
  tc_ok("mul 3*(2G) is 6G", cr_equal(&a[0], &p6[0], 97));
  for i in 0..97 { a[i] = p2[i]; }
  tc_ok("mul with a one-byte multiplier", crx_p384_mul(&a[0], 97, &sc[47], 1) == 1);
  tc_ok("mul with a one-byte multiplier is 6G", cr_equal(&a[0], &p6[0], 97));
  for i in 0..97 { a[i] = p2[i]; }
  a[0] = 5;
  tc_ok("mul refuses an invalid point", crx_p384_mul(&a[0], 97, &sc[0], 48) == 0);
  tc_ok("mul refuses a wrong length", crx_p384_mul(&a[0], 65, &sc[0], 48) == 0);
  var gm: uint8[97];
  tc_ok("mulgen returns 97", crx_p384_mulgen(&gm[0], &sc[0], 48) == 97);
  tc_ok("mulgen 3 is 3G", cr_equal(&gm[0], &p3[0], 97));
  cr_wipe(&sk.b[0], 48);
}

// Release time per ECDH, key pair, sign and verify, printed for the report.
fn timing() {
  var ska: CrP384Secret;
  var skb: CrP384Secret;
  var pka: uint8[97];
  var pkb: uint8[97];
  var z: uint8[48];
  var sig: uint8[104];
  var sl: int64 = 0;
  var msg: uint8[32];
  cr_p384_keypair(&pka[0], 97, &ska);
  cr_p384_keypair(&pkb[0], 97, &skb);
  var t0: int64 = time_mono_us();
  var okk: int32 = 0;
  for i in 0..10 {
    if (cr_p384_ecdh(&z[0], 48, &ska, &pkb[0], 97) == CR_OK) { okk = okk + 1; }
  }
  var t1: int64 = time_mono_us();
  for i in 0..10 {
    msg[0] = (uint8)i;
    cr_p384_ecdsa_sign(&sig[0], 104, &sl, &msg[0], 32, CR_HASH_SHA384, &ska);
  }
  var t2: int64 = time_mono_us();
  var okc: int32 = 0;
  for i in 0..10 {
    msg[0] = 9;
    if (cr_p384_ecdsa_verify(&sig[0], sl, &msg[0], 32, CR_HASH_SHA384, &pka[0], 97)) { okc = okc + 1; }
  }
  var t3: int64 = time_mono_us();
  for i in 0..10 {
    cr_p384_public_from_secret(&pkb[0], 97, &skb);
  }
  var t4: int64 = time_mono_us();
  tc_ok("timing run ecdh ok", okk == 10);
  tc_ok("timing run verifies", okc == 10);
  println("timing: ecdh {(t1 - t0) / 10} us, sign {(t2 - t1) / 10} us, verify {(t3 - t2) / 10} us, public_from_secret {(t4 - t3) / 10} us (average of 10)");
  cr_wipe(&ska.b[0], 48);
  cr_wipe(&skb.b[0], 48);
}

fn main() -> int32 {
  keypair_rows();
  pkv_rows();
  ecdh_rows();
  wycheproof_ecdh_rows();
  rfc6979();
  cavp_ecdsa_rows();
  wp_ecdsa_rows(&VEC_WP_ECDSA_384_SHA384[0], VEC_WP_ECDSA_384_SHA384_N, "wp sha384");
  wp_ecdsa_rows(&VEC_WP_ECDSA_384_SHA512[0], VEC_WP_ECDSA_384_SHA512_N, "wp sha512");
  key_round_trips();
  scalar_edges();
  peer_forms();
  argument_errors();
  sign_round_trips();
  signature_forms();
  key_forms();
  sign_argument_errors();
  internal_routines();
  timing();
  return tc_finish("p384");
}
