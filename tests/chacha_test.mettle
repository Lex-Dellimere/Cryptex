// ChaCha20, Poly1305 and HChaCha20 internals against the published vectors:
// RFC 8439 2.3.2, 2.4.2, 2.5.2, 2.6.2, 2.8.2 and draft-irtf-cfrg-xchacha-03
// 2.2.1. Also streaming splits for Poly1305 and in-place XOR.
import "cryptex/cipher/chacha";
import "cryptex/cipher/poly1305";
import "cryptex/core/util";
import "tcheck";

fn seq_key(k: uint8*) {
  var i: int32 = 0;
  while (i < 32) {
    k[i] = (uint8)i;
    i = i + 1;
  }
}

fn main() -> int32 {
  var key: uint8[32];
  var nonce: uint8[12];
  var out: uint8[64];

  // 2.3.2 block function
  seq_key(&key[0]);
  tc_unhex("000000090000004a00000000", &nonce[0], 12);
  crx_chacha20_block(&key[0], 1, &nonce[0], &out[0]);
  tc_hex_eq("2.3.2 block", &out[0], 64,
    "10f1e7e4d13b5915500fdd1fa32071c4c7d1f4c733c068030422aa9ac3d46c4ed2826446079faa0914c2d705d98b02a2b5129cd1de164eb9cbd083e8a2503c4e");

  // 2.4.2 encryption
  var pt: string = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.";
  var n: int64 = (int64)pt.length;
  var ct: uint8[128];
  tc_unhex("000000000000004a00000000", &nonce[0], 12);
  crx_chacha20_xor(&ct[0], pt.chars, n, &key[0], &nonce[0], 1);
  tc_ok("2.4.2 length", n == 114);
  tc_hex_eq("2.4.2 ciphertext", &ct[0], n,
    "6e2e359a2568f98041ba0728dd0d6981e97e7aec1d4360c20a27afccfd9fae0bf91b65c5524733ab8f593dabcd62b3571639d624e65152ab8f530c359f0861d807ca0dbf500d6a6156a38e088a22b65e52bc514d16ccf806818ce91ab77937365af90bbf74a35be6b40b8eedf2785e42874d");
  // out == inp (decrypt in place)
  crx_chacha20_xor(&ct[0], &ct[0], n, &key[0], &nonce[0], 1);
  tc_ok("2.4.2 in place round trip", cr_equal(&ct[0], pt.chars, n));
  // Zero-length is a no-op.
  crx_chacha20_xor(&ct[0], &ct[0], 0, &key[0], &nonce[0], 1);
  tc_ok("zero length untouched", cr_equal(&ct[0], pt.chars, n));

  // 2.5.2 Poly1305
  var pkey: uint8[32];
  var msg: string = "Cryptographic Forum Research Group";
  var st: CrxPoly1305;
  var tag: uint8[16];
  tc_unhex("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b", &pkey[0], 32);
  crx_poly1305_init(&st, &pkey[0]);
  crx_poly1305_update(&st, msg.chars, (int64)msg.length);
  crx_poly1305_final(&st, &tag[0]);
  tc_hex_eq("2.5.2 tag", &tag[0], 16, "a8061dc1305136c6c22b8baf0c0127a9");
  tc_ok("poly state wiped", tc_all_zero((uint8*)&st.r[0], 20) && tc_all_zero((uint8*)&st.h[0], 20) && tc_all_zero((uint8*)&st.pad[0], 16) && st.buflen == 0);
  // Every split of the message into two updates gives the same tag.
  var split: int64 = 0;
  var splits_ok: bool = true;
  while (split <= 34) {
    crx_poly1305_init(&st, &pkey[0]);
    crx_poly1305_update(&st, msg.chars, split);
    crx_poly1305_update(&st, &msg.chars[split], 34 - split);
    crx_poly1305_final(&st, &tag[0]);
    var hx: string = tc_hex(&tag[0], 16);
    if (hx != "a8061dc1305136c6c22b8baf0c0127a9") { splits_ok = false; }
    free(hx.chars);
    split = split + 1;
  }
  tc_ok("2.5.2 all two-way splits", splits_ok);
  // Byte at a time.
  crx_poly1305_init(&st, &pkey[0]);
  var bi: int64 = 0;
  while (bi < 34) {
    crx_poly1305_update(&st, &msg.chars[bi], 1);
    bi = bi + 1;
  }
  crx_poly1305_final(&st, &tag[0]);
  tc_hex_eq("2.5.2 byte at a time", &tag[0], 16, "a8061dc1305136c6c22b8baf0c0127a9");
  // Empty message: tag is s.
  crx_poly1305_init(&st, &pkey[0]);
  crx_poly1305_final(&st, &tag[0]);
  tc_hex_eq("empty message tag = s", &tag[0], 16, "0103808afb0db2fd4abff6af4149f51b");

  // 2.6.2 Poly1305 key generation
  var k2: uint8[32];
  tc_unhex("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f", &k2[0], 32);
  tc_unhex("000000000001020304050607", &nonce[0], 12);
  crx_chacha20_block(&k2[0], 0, &nonce[0], &out[0]);
  tc_hex_eq("2.6.2 one-time key", &out[0], 32,
    "8ad5a08b905f81cc815040274ab29471a833b637e3fd0da508dbb8e2fdd1a646");

  // 2.8.2 AEAD_CHACHA20_POLY1305 (12-byte nonce), built from the internals.
  var ad: uint8[12];
  tc_unhex("50515253c0c1c2c3c4c5c6c7", &ad[0], 12);
  tc_unhex("070000004041424344454647", &nonce[0], 12);
  crx_chacha20_block(&k2[0], 0, &nonce[0], &out[0]);
  tc_hex_eq("2.8.2 one-time key", &out[0], 32,
    "7bac2b252db447af09b67a55a4e955840ae1d6731075d9eb2a9375783ed553ff");
  crx_chacha20_xor(&ct[0], pt.chars, n, &k2[0], &nonce[0], 1);
  tc_hex_eq("2.8.2 ciphertext", &ct[0], n,
    "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b6116");
  // MAC data: ad || pad(4) || ct(114) || pad(14) || le64(12) || le64(114)
  var mac: uint8[160];
  tc_fill(&mac[0], 160, 0);
  var i: int64 = 0;
  while (i < 12) {
    mac[i] = ad[i];
    i = i + 1;
  }
  i = 0;
  while (i < n) {
    mac[16 + i] = ct[i];
    i = i + 1;
  }
  mac[144] = 12;
  mac[152] = 114;
  crx_poly1305_init(&st, &out[0]);
  crx_poly1305_update(&st, &mac[0], 160);
  crx_poly1305_final(&st, &tag[0]);
  tc_hex_eq("2.8.2 tag", &tag[0], 16, "1ae10b594f09e26a7e902ecbd0600691");

  // draft-irtf-cfrg-xchacha-03 2.2.1 HChaCha20
  var sub: uint8[32];
  var n16: uint8[16];
  seq_key(&key[0]);
  tc_unhex("000000090000004a0000000031415927", &n16[0], 16);
  crx_hchacha20(&sub[0], &key[0], &n16[0]);
  tc_hex_eq("xchacha 2.2.1 HChaCha20", &sub[0], 32,
    "82413b4227b27bfed30e42508a877d73a0f9e4d58a74a853c12ec41326d3ecdc");

  return tc_finish("chacha");
}
