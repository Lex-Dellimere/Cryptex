// The SHA-NI SHA-256 path against the portable compression: 0 to 20 blocks
// of patterned data from several chaining values, and data at odd offsets.
// Skipped when the CPU has no SHA-NI.
import "crypto/hash/sha2";
import "crypto/core/util";
import "tcheck";

import "crypto/hash/sha256_hw_x86_64" if x86_64;
import "crypto/hash/sha256_hw_aarch64" if aarch64;

var g_data: uint8[1400];
var g_k: uint32[64] = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
];

fn main() -> int32 {
  if (crx_sha256_hw_available() == (uint32)0) {
    tc_ok("no SHA-NI on this CPU, skipped", true);
    return tc_finish("sha256_hw");
  }
  var i: int32 = 0;
  while (i < 1400) {
    g_data[i] = (uint8)((i * 167 + 13) & 255);
    i = i + 1;
  }
  var bad: int32 = 0;
  var seed: uint32 = (uint32)0x9e3779b9;
  var off: int64 = 0;
  while (off < 3) {
    var nb: int64 = 0;
    while (nb <= 20) {
      var a: CrxSha256;
      var b: CrxSha256;
      crx_sha256_init(&a);
      var j: int32 = 0;
      while (j < 8) {
        seed = seed * (uint32)1664525 + (uint32)1013904223;
        a.h[j] = seed;
        b.h[j] = seed;
        j = j + 1;
      }
      var k: int64 = 0;
      while (k < nb) {
        crx_sha256_block_sw(&a, &g_data[off + k * 64]);
        k = k + 1;
      }
      crx_sha256_hw_blocks(&b.h[0], &g_data[off], nb, &g_k[0]);
      j = 0;
      while (j < 8) {
        if (a.h[j] != b.h[j]) { bad = bad + 1; }
        j = j + 1;
      }
      nb = nb + 1;
    }
    off = off + 1;
  }
  tc_ok("SHA-NI blocks match the portable code", bad == 0);
  return tc_finish("sha256_hw");
}
