// Hashes: SHA-256, SHA-512 (FIPS 180-4, sha2) and BLAKE2b (RFC 7693, blake2b),
// all pure Mettle.
//
// None of these is a password hash (use cr_pwhash_str) or a MAC (use
// cr_hmac_* or keyed BLAKE2b).

import "status";
import "types";
import "core";
import "blake2b";
import "sha2";

/// Smallest BLAKE2b output length cr_blake2b accepts (a hash shorter than this is too weak to be useful).
/// in: - 
/// returns: 16
/// owns: nothing
/// thread: constant
/// example: cr_blake2b(&o[0], CR_BLAKE2B_MIN, m, n, 0, 0);
export const CR_BLAKE2B_MIN: int64 = 16;
/// Largest BLAKE2b output and key length (the RFC 7693 maximum).
/// in: -
/// returns: 64
/// owns: nothing
/// thread: constant
/// example: var o: uint8[64]; cr_blake2b(&o[0], CR_BLAKE2B_MAX, m, n, 0, 0);
export const CR_BLAKE2B_MAX: int64 = 64;
/// Smallest non-empty BLAKE2b key (shorter keys are too weak to be useful).
/// in: -
/// returns: 16
/// owns: nothing
/// thread: constant
/// example: cr_blake2b(&o[0], 32, m, n, &k[0], CR_BLAKE2B_KEY_MIN);
export const CR_BLAKE2B_KEY_MIN: int64 = 16;

// A valid address for zero-length inputs, so the hash code never sees a null
// pointer.
var g_cr_hash_empty: uint8[1];

fn cr_hash_in(p: uint8*, n: int64) -> uint8* {
  if (p == 0 || n == 0) { return &g_cr_hash_empty[0]; }
  return p;
}

/// Computes SHA-256 of n bytes (FIPS 180-4).
/// in: out; msg readable for n bytes (may be 0 when n == 0); n >= 0
/// returns: CR_OK; CR_E_ARG (null out, null msg with n > 0, n < 0). On error
///   out is not written
/// owns: nothing; the caller owns out and msg
/// thread: any thread (no shared state)
/// example: var d: CrSha256; cr_sha256(&d, s.chars, (int64)s.length);
export fn cr_sha256(out: CrSha256*, msg: uint8*, n: int64) -> int32 {
  if (out == 0 || n < 0 || (msg == 0 && n > 0)) { return CR_E_ARG; }
  var s: CrxSha256;
  crx_sha256_init(&s);
  crx_sha256_update(&s, msg, n);
  crx_sha256_final(&s, &out->b[0]);
  return CR_OK;
}

/// Computes SHA-512 of n bytes (FIPS 180-4).
/// in: out; msg readable for n bytes (may be 0 when n == 0); n >= 0
/// returns: CR_OK; CR_E_ARG (null out, null msg with n > 0, n < 0). On error
///   out is not written
/// owns: nothing; the caller owns out and msg
/// thread: any thread (no shared state)
/// example: var d: CrSha512; cr_sha512(&d, s.chars, (int64)s.length);
export fn cr_sha512(out: CrSha512*, msg: uint8*, n: int64) -> int32 {
  if (out == 0 || n < 0 || (msg == 0 && n > 0)) { return CR_E_ARG; }
  var s: CrxSha512;
  crx_sha512_init(&s);
  crx_sha512_update(&s, msg, n);
  crx_sha512_final(&s, &out->b[0]);
  return CR_OK;
}

/// Computes BLAKE2b (RFC 7693), optionally
/// keyed (then it is a MAC/PRF), with a chosen output length.
/// in: out writable for outlen bytes, outlen in [16, 64];
///   msg readable for n bytes (0 allowed when n == 0), n >= 0;
///   key readable for keylen bytes, keylen 0 (unkeyed; key may be 0) or in
///   [16, 64]
/// returns: CR_OK; CR_E_ARG for any length outside those ranges or a null
///   pointer with a non-zero length. On error out is not written
/// owns: nothing; the caller owns out, msg and key (wipe the key yourself)
/// thread: any thread (no shared state)
/// example: var d: uint8[32]; cr_blake2b(&d[0], 32, s.chars, (int64)s.length, 0, 0);
export fn cr_blake2b(out: uint8*, outlen: int64, msg: uint8*, n: int64, key: uint8*, keylen: int64) -> int32 {
  if (out == 0 || outlen < CR_BLAKE2B_MIN || outlen > CR_BLAKE2B_MAX) { return CR_E_ARG; }
  if (n < 0 || (msg == 0 && n > 0)) { return CR_E_ARG; }
  if (keylen != 0) {
    if (key == 0 || keylen < CR_BLAKE2B_KEY_MIN || keylen > CR_BLAKE2B_MAX) { return CR_E_ARG; }
  }
  var s: CrxBlake2b;
  var kp: uint8* = 0;
  if (keylen > 0) { kp = key; }
  crx_blake2b_init(&s, outlen, kp, keylen);
  crx_blake2b_update(&s, msg, n);
  crx_blake2b_final(&s, out);
  return CR_OK;
}
