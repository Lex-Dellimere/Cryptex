// Signatures: Ed25519 (RFC 8032; libsodium crypto_sign_*), detached form.
// libsodium's secret key is 64 bytes: the RFC 8032 32-byte private key
// (the seed) followed by the public key.

import "status";
import "types";
import "core";

extern fn crypto_sign_keypair(pk: uint8*, sk: uint8*) -> int32 = "crypto_sign_keypair";
extern fn crypto_sign_seed_keypair(pk: uint8*, sk: uint8*, seed: uint8*) -> int32 = "crypto_sign_seed_keypair";
extern fn crypto_sign_detached(sig: uint8*, siglen_p: uint64*, m: uint8*, mlen: uint64, sk: uint8*) -> int32 = "crypto_sign_detached";
extern fn crypto_sign_verify_detached(sig: uint8*, m: uint8*, mlen: uint64, pk: uint8*) -> int32 = "crypto_sign_verify_detached";

var g_cr_sign_empty: uint8[1];

fn cr_sign_ptr(p: uint8*, n: int64) -> uint8* {
  if (p == 0 || n == 0) { return &g_cr_sign_empty[0]; }
  return p;
}

/// Generates a random Ed25519 key pair (crypto_sign_keypair).
/// in: pk, sk
/// returns: CR_OK; CR_E_ARG; CR_E_INIT; CR_E_INTERNAL
/// owns: sk is secret caller memory: cr_wipe(&sk.b[0], 64) when done
/// thread: main thread only
/// example: var pk: CrEd25519Public; var sk: CrEd25519Secret; cr_ed25519_keypair(&pk, &sk);
export fn cr_ed25519_keypair(pk: CrEd25519Public*, sk: CrEd25519Secret*) -> int32 {
  if (pk == 0 || sk == 0) { return CR_E_ARG; }
  if (cr_init() != CR_OK) { return CR_E_INIT; }
  if (crypto_sign_keypair(&pk->b[0], &sk->b[0]) != 0) {
    cr_wipe(&sk->b[0], 64);
    return CR_E_INTERNAL;
  }
  return CR_OK;
}

/// Derives the Ed25519 key pair of a 32-byte seed (the RFC 8032 private key)
/// deterministically (crypto_sign_seed_keypair).
/// in: pk, sk; seed
/// returns: CR_OK; CR_E_ARG; CR_E_INIT; CR_E_INTERNAL
/// owns: seed and sk are secret caller memory: wipe both when done
/// thread: main thread only
/// example: cr_ed25519_seed_keypair(&pk, &sk, &seed);
export fn cr_ed25519_seed_keypair(pk: CrEd25519Public*, sk: CrEd25519Secret*, seed: CrSeed32*) -> int32 {
  if (pk == 0 || sk == 0 || seed == 0) { return CR_E_ARG; }
  if (cr_init() != CR_OK) { return CR_E_INIT; }
  if (crypto_sign_seed_keypair(&pk->b[0], &sk->b[0], &seed->b[0]) != 0) {
    cr_wipe(&sk->b[0], 64);
    return CR_E_INTERNAL;
  }
  return CR_OK;
}

/// Signs msg, producing a detached 64-byte signature (crypto_sign_detached).
/// Ed25519 is deterministic: the same key and message give the same
/// signature.
/// in: sig; msg/n (0 allowed when n == 0); sk
/// returns: CR_OK; CR_E_ARG (null sig/sk, null msg with n > 0, n < 0);
///   CR_E_INIT; CR_E_INTERNAL. On error sig is zeroed
/// owns: nothing; the caller owns sk and must wipe it when done
/// thread: main thread only
/// example: var sig: CrEd25519Sig; cr_ed25519_sign(&sig, m.chars, (int64)m.length, &sk);
export fn cr_ed25519_sign(sig: CrEd25519Sig*, msg: uint8*, n: int64, sk: CrEd25519Secret*) -> int32 {
  if (sig == 0) { return CR_E_ARG; }
  cr_wipe(&sig->b[0], 64);
  if (sk == 0 || n < 0 || (msg == 0 && n > 0)) { return CR_E_ARG; }
  if (cr_init() != CR_OK) { return CR_E_INIT; }
  var slen: uint64 = 0;
  if (crypto_sign_detached(&sig->b[0], &slen, cr_sign_ptr(msg, n), (uint64)n, &sk->b[0]) != 0 || slen != 64) {
    cr_wipe(&sig->b[0], 64);
    return CR_E_INTERNAL;
  }
  return CR_OK;
}

/// Verifies a detached Ed25519 signature (crypto_sign_verify_detached, which
/// rejects non-canonical and small-order encodings).
/// in: sig; msg/n; pk, the signer's public key
/// returns: true only if sig is a valid signature of exactly these n bytes
///   under pk; false otherwise and for every argument error (fails closed)
/// owns: nothing
/// thread: main thread only
/// example: if (!cr_ed25519_verify(&sig, m.chars, (int64)m.length, &pk)) { reject(); }
export fn cr_ed25519_verify(sig: CrEd25519Sig*, msg: uint8*, n: int64, pk: CrEd25519Public*) -> bool {
  if (sig == 0 || pk == 0 || n < 0 || (msg == 0 && n > 0)) { return false; }
  if (cr_init() != CR_OK) { return false; }
  var rc: int32 = crypto_sign_verify_detached(&sig->b[0], cr_sign_ptr(msg, n), (uint64)n, &pk->b[0]);
  return rc == 0;
}
