// ChaCha20 keystream on x86-64 with SSSE3 (two blocks per pass) and AVX2
// (four blocks per pass), chosen at run time (crx_chacha_hw_level). The
// scalar code in chacha.mettle stays the fallback and does any tail.
//
// Layout: one 16-byte row of the ChaCha state per register (an AVX2 register
// holds the same row of two blocks, one per 128-bit lane), the column round on
// rows as they are, then the diagonal round after rotating rows 1, 2 and 3 by
// one, two and three words with pshufd, then back. Rotations by 16 and 8 bits
// are byte shuffles (pshufb); by 12 and 7 bits two shifts and an or. This is
// the layout of RustCrypto's chacha20 crate (sse2 and avx2 backends) and of
// libsodium's chacha20 SIMD code (Romain Dolbeau); see docs/references.md.
//
// The Mettle assembler does not know pshufb, pshufd, pslld, psrld or any
// VEX (ymm) instruction, so those are db bytes from GNU as, with the
// instruction beside each line. There is no branch, address or table lookup
// that depends on the key or data, so these paths are constant time.
// Internal: the public entry points are cr_aead_* and cr_chacha20poly1305_*.

/// internal: 2 if this CPU has AVX2 and the OS saves ymm registers, 1 if it
/// has SSSE3 only, else 0.
@naked export fn crx_chacha_hw_level() -> uint32 {
  asm {
    push rbx
    mov eax, 1
    xor ecx, ecx
    cpuid
    xor r8d, r8d
    test ecx, 0x200
    jz done
    mov r8d, 1
    mov r9d, ecx
    and r9d, 0x18000000
    cmp r9d, 0x18000000
    jne done
    xor ecx, ecx
    xgetbv
    and eax, 6
    cmp eax, 6
    jne done
    mov eax, 7
    xor ecx, ecx
    cpuid
    test ebx, 0x20
    jz done
    mov r8d, 2
  done:
    mov eax, r8d
    pop rbx
    ret
  }
}

/// internal: XORs nblocks * 64 bytes of src with the ChaCha20 keystream into
/// dst, with AVX2. st is the 16-word input state (constants, key, block
/// counter, nonce); block i uses counter st[12] + i, wrapping modulo 2^32.
/// st is not changed. Needs crx_chacha_hw_level() == 2.
/// in: nblocks >= 0 and a multiple of 4; src and dst readable/writable for
///   nblocks * 64 bytes (dst may equal src, no other overlap)
@naked export fn crx_chacha_avx2_blocks(st: uint32*, src: uint8*, dst: uint8*, nblocks: int64) {
  asm {
    test rcx, rcx
    jz done
    sub rsp, 160
    mov rax, 0x0504070601000302
    mov [rsp+0], rax
    mov rax, 0x0d0c0f0e09080b0a
    mov [rsp+8], rax
    mov rax, 0x0504070601000302
    mov [rsp+16], rax
    mov rax, 0x0d0c0f0e09080b0a
    mov [rsp+24], rax
    mov rax, 0x0605040702010003
    mov [rsp+32], rax
    mov rax, 0x0e0d0c0f0a09080b
    mov [rsp+40], rax
    mov rax, 0x0605040702010003
    mov [rsp+48], rax
    mov rax, 0x0e0d0c0f0a09080b
    mov [rsp+56], rax
    mov rax, 0x0000000000000000
    mov [rsp+64], rax
    mov rax, 0x0000000000000000
    mov [rsp+72], rax
    mov rax, 0x0000000000000001
    mov [rsp+80], rax
    mov rax, 0x0000000000000000
    mov [rsp+88], rax
    mov rax, 0x0000000000000002
    mov [rsp+96], rax
    mov rax, 0x0000000000000000
    mov [rsp+104], rax
    mov rax, 0x0000000000000002
    mov [rsp+112], rax
    mov rax, 0x0000000000000000
    mov [rsp+120], rax
    mov rax, 0x0000000000000004
    mov [rsp+128], rax
    mov rax, 0x0000000000000000
    mov [rsp+136], rax
    mov rax, 0x0000000000000004
    mov [rsp+144], rax
    mov rax, 0x0000000000000000
    mov [rsp+152], rax
    db 0xc5, 0x7e, 0x6f, 0x14, 0x24   ; vmovdqu ymm10, [rsp]
    db 0xc5, 0x7e, 0x6f, 0x5c, 0x24, 0x20   ; vmovdqu ymm11, [rsp+32]
    db 0xc4, 0x62, 0x7d, 0x5a, 0x27   ; vbroadcasti128 ymm12, [rdi]
    db 0xc4, 0x62, 0x7d, 0x5a, 0x6f, 0x10   ; vbroadcasti128 ymm13, [rdi+16]
    db 0xc4, 0x62, 0x7d, 0x5a, 0x77, 0x20   ; vbroadcasti128 ymm14, [rdi+32]
    db 0xc4, 0x62, 0x7d, 0x5a, 0x7f, 0x30   ; vbroadcasti128 ymm15, [rdi+48]
    db 0xc5, 0x05, 0xfe, 0x7c, 0x24, 0x40   ; vpaddd ymm15, ymm15, [rsp+64]
  next4:
    db 0xc5, 0x7d, 0x7f, 0xe0   ; vmovdqa ymm0, ymm12
    db 0xc5, 0x7d, 0x7f, 0xe9   ; vmovdqa ymm1, ymm13
    db 0xc5, 0x7d, 0x7f, 0xf2   ; vmovdqa ymm2, ymm14
    db 0xc5, 0x7d, 0x7f, 0xfb   ; vmovdqa ymm3, ymm15
    db 0xc5, 0x7d, 0x7f, 0xe4   ; vmovdqa ymm4, ymm12
    db 0xc5, 0x7d, 0x7f, 0xed   ; vmovdqa ymm5, ymm13
    db 0xc5, 0x7d, 0x7f, 0xf6   ; vmovdqa ymm6, ymm14
    db 0xc5, 0x85, 0xfe, 0x7c, 0x24, 0x60   ; vpaddd ymm7, ymm15, [rsp+96]
    mov eax, 10
  dround:
    db 0xc5, 0xfd, 0xfe, 0xc1   ; vpaddd ymm0, ymm0, ymm1
    db 0xc5, 0xdd, 0xfe, 0xe5   ; vpaddd ymm4, ymm4, ymm5
    db 0xc5, 0xe5, 0xef, 0xd8   ; vpxor ymm3, ymm3, ymm0
    db 0xc5, 0xc5, 0xef, 0xfc   ; vpxor ymm7, ymm7, ymm4
    db 0xc4, 0xc2, 0x65, 0x00, 0xda   ; vpshufb ymm3, ymm3, ymm10
    db 0xc4, 0xc2, 0x45, 0x00, 0xfa   ; vpshufb ymm7, ymm7, ymm10
    db 0xc5, 0xed, 0xfe, 0xd3   ; vpaddd ymm2, ymm2, ymm3
    db 0xc5, 0xcd, 0xfe, 0xf7   ; vpaddd ymm6, ymm6, ymm7
    db 0xc5, 0xf5, 0xef, 0xca   ; vpxor ymm1, ymm1, ymm2
    db 0xc5, 0xd5, 0xef, 0xee   ; vpxor ymm5, ymm5, ymm6
    db 0xc5, 0xbd, 0x72, 0xf1, 0x0c   ; vpslld ymm8, ymm1, 12
    db 0xc5, 0xb5, 0x72, 0xf5, 0x0c   ; vpslld ymm9, ymm5, 12
    db 0xc5, 0xf5, 0x72, 0xd1, 0x14   ; vpsrld ymm1, ymm1, 20
    db 0xc5, 0xd5, 0x72, 0xd5, 0x14   ; vpsrld ymm5, ymm5, 20
    db 0xc4, 0xc1, 0x75, 0xeb, 0xc8   ; vpor ymm1, ymm1, ymm8
    db 0xc4, 0xc1, 0x55, 0xeb, 0xe9   ; vpor ymm5, ymm5, ymm9
    db 0xc5, 0xfd, 0xfe, 0xc1   ; vpaddd ymm0, ymm0, ymm1
    db 0xc5, 0xdd, 0xfe, 0xe5   ; vpaddd ymm4, ymm4, ymm5
    db 0xc5, 0xe5, 0xef, 0xd8   ; vpxor ymm3, ymm3, ymm0
    db 0xc5, 0xc5, 0xef, 0xfc   ; vpxor ymm7, ymm7, ymm4
    db 0xc4, 0xc2, 0x65, 0x00, 0xdb   ; vpshufb ymm3, ymm3, ymm11
    db 0xc4, 0xc2, 0x45, 0x00, 0xfb   ; vpshufb ymm7, ymm7, ymm11
    db 0xc5, 0xed, 0xfe, 0xd3   ; vpaddd ymm2, ymm2, ymm3
    db 0xc5, 0xcd, 0xfe, 0xf7   ; vpaddd ymm6, ymm6, ymm7
    db 0xc5, 0xf5, 0xef, 0xca   ; vpxor ymm1, ymm1, ymm2
    db 0xc5, 0xd5, 0xef, 0xee   ; vpxor ymm5, ymm5, ymm6
    db 0xc5, 0xbd, 0x72, 0xf1, 0x07   ; vpslld ymm8, ymm1, 7
    db 0xc5, 0xb5, 0x72, 0xf5, 0x07   ; vpslld ymm9, ymm5, 7
    db 0xc5, 0xf5, 0x72, 0xd1, 0x19   ; vpsrld ymm1, ymm1, 25
    db 0xc5, 0xd5, 0x72, 0xd5, 0x19   ; vpsrld ymm5, ymm5, 25
    db 0xc4, 0xc1, 0x75, 0xeb, 0xc8   ; vpor ymm1, ymm1, ymm8
    db 0xc4, 0xc1, 0x55, 0xeb, 0xe9   ; vpor ymm5, ymm5, ymm9
    db 0xc5, 0xfd, 0x70, 0xc9, 0x39   ; vpshufd ymm1, ymm1, 0x39
    db 0xc5, 0xfd, 0x70, 0xd2, 0x4e   ; vpshufd ymm2, ymm2, 0x4e
    db 0xc5, 0xfd, 0x70, 0xdb, 0x93   ; vpshufd ymm3, ymm3, 0x93
    db 0xc5, 0xfd, 0x70, 0xed, 0x39   ; vpshufd ymm5, ymm5, 0x39
    db 0xc5, 0xfd, 0x70, 0xf6, 0x4e   ; vpshufd ymm6, ymm6, 0x4e
    db 0xc5, 0xfd, 0x70, 0xff, 0x93   ; vpshufd ymm7, ymm7, 0x93
    db 0xc5, 0xfd, 0xfe, 0xc1   ; vpaddd ymm0, ymm0, ymm1
    db 0xc5, 0xdd, 0xfe, 0xe5   ; vpaddd ymm4, ymm4, ymm5
    db 0xc5, 0xe5, 0xef, 0xd8   ; vpxor ymm3, ymm3, ymm0
    db 0xc5, 0xc5, 0xef, 0xfc   ; vpxor ymm7, ymm7, ymm4
    db 0xc4, 0xc2, 0x65, 0x00, 0xda   ; vpshufb ymm3, ymm3, ymm10
    db 0xc4, 0xc2, 0x45, 0x00, 0xfa   ; vpshufb ymm7, ymm7, ymm10
    db 0xc5, 0xed, 0xfe, 0xd3   ; vpaddd ymm2, ymm2, ymm3
    db 0xc5, 0xcd, 0xfe, 0xf7   ; vpaddd ymm6, ymm6, ymm7
    db 0xc5, 0xf5, 0xef, 0xca   ; vpxor ymm1, ymm1, ymm2
    db 0xc5, 0xd5, 0xef, 0xee   ; vpxor ymm5, ymm5, ymm6
    db 0xc5, 0xbd, 0x72, 0xf1, 0x0c   ; vpslld ymm8, ymm1, 12
    db 0xc5, 0xb5, 0x72, 0xf5, 0x0c   ; vpslld ymm9, ymm5, 12
    db 0xc5, 0xf5, 0x72, 0xd1, 0x14   ; vpsrld ymm1, ymm1, 20
    db 0xc5, 0xd5, 0x72, 0xd5, 0x14   ; vpsrld ymm5, ymm5, 20
    db 0xc4, 0xc1, 0x75, 0xeb, 0xc8   ; vpor ymm1, ymm1, ymm8
    db 0xc4, 0xc1, 0x55, 0xeb, 0xe9   ; vpor ymm5, ymm5, ymm9
    db 0xc5, 0xfd, 0xfe, 0xc1   ; vpaddd ymm0, ymm0, ymm1
    db 0xc5, 0xdd, 0xfe, 0xe5   ; vpaddd ymm4, ymm4, ymm5
    db 0xc5, 0xe5, 0xef, 0xd8   ; vpxor ymm3, ymm3, ymm0
    db 0xc5, 0xc5, 0xef, 0xfc   ; vpxor ymm7, ymm7, ymm4
    db 0xc4, 0xc2, 0x65, 0x00, 0xdb   ; vpshufb ymm3, ymm3, ymm11
    db 0xc4, 0xc2, 0x45, 0x00, 0xfb   ; vpshufb ymm7, ymm7, ymm11
    db 0xc5, 0xed, 0xfe, 0xd3   ; vpaddd ymm2, ymm2, ymm3
    db 0xc5, 0xcd, 0xfe, 0xf7   ; vpaddd ymm6, ymm6, ymm7
    db 0xc5, 0xf5, 0xef, 0xca   ; vpxor ymm1, ymm1, ymm2
    db 0xc5, 0xd5, 0xef, 0xee   ; vpxor ymm5, ymm5, ymm6
    db 0xc5, 0xbd, 0x72, 0xf1, 0x07   ; vpslld ymm8, ymm1, 7
    db 0xc5, 0xb5, 0x72, 0xf5, 0x07   ; vpslld ymm9, ymm5, 7
    db 0xc5, 0xf5, 0x72, 0xd1, 0x19   ; vpsrld ymm1, ymm1, 25
    db 0xc5, 0xd5, 0x72, 0xd5, 0x19   ; vpsrld ymm5, ymm5, 25
    db 0xc4, 0xc1, 0x75, 0xeb, 0xc8   ; vpor ymm1, ymm1, ymm8
    db 0xc4, 0xc1, 0x55, 0xeb, 0xe9   ; vpor ymm5, ymm5, ymm9
    db 0xc5, 0xfd, 0x70, 0xc9, 0x93   ; vpshufd ymm1, ymm1, 0x93
    db 0xc5, 0xfd, 0x70, 0xd2, 0x4e   ; vpshufd ymm2, ymm2, 0x4e
    db 0xc5, 0xfd, 0x70, 0xdb, 0x39   ; vpshufd ymm3, ymm3, 0x39
    db 0xc5, 0xfd, 0x70, 0xed, 0x93   ; vpshufd ymm5, ymm5, 0x93
    db 0xc5, 0xfd, 0x70, 0xf6, 0x4e   ; vpshufd ymm6, ymm6, 0x4e
    db 0xc5, 0xfd, 0x70, 0xff, 0x39   ; vpshufd ymm7, ymm7, 0x39
    dec eax
    jnz dround
    db 0xc4, 0xc1, 0x7d, 0xfe, 0xc4   ; vpaddd ymm0, ymm0, ymm12
    db 0xc4, 0xc1, 0x75, 0xfe, 0xcd   ; vpaddd ymm1, ymm1, ymm13
    db 0xc4, 0xc1, 0x6d, 0xfe, 0xd6   ; vpaddd ymm2, ymm2, ymm14
    db 0xc4, 0xc1, 0x65, 0xfe, 0xdf   ; vpaddd ymm3, ymm3, ymm15
    db 0xc4, 0xc1, 0x5d, 0xfe, 0xe4   ; vpaddd ymm4, ymm4, ymm12
    db 0xc4, 0xc1, 0x55, 0xfe, 0xed   ; vpaddd ymm5, ymm5, ymm13
    db 0xc4, 0xc1, 0x4d, 0xfe, 0xf6   ; vpaddd ymm6, ymm6, ymm14
    db 0xc4, 0xc1, 0x45, 0xfe, 0xff   ; vpaddd ymm7, ymm7, ymm15
    db 0xc5, 0xc5, 0xfe, 0x7c, 0x24, 0x60   ; vpaddd ymm7, ymm7, [rsp+96]
    db 0xc4, 0x63, 0x7d, 0x46, 0xc1, 0x20   ; vperm2i128 ymm8, ymm0, ymm1, 0x20
    db 0xc5, 0x3d, 0xef, 0x06   ; vpxor ymm8, ymm8, [rsi+0]
    db 0xc5, 0x7e, 0x7f, 0x02   ; vmovdqu [rdx+0], ymm8
    db 0xc4, 0x63, 0x6d, 0x46, 0xc3, 0x20   ; vperm2i128 ymm8, ymm2, ymm3, 0x20
    db 0xc5, 0x3d, 0xef, 0x46, 0x20   ; vpxor ymm8, ymm8, [rsi+32]
    db 0xc5, 0x7e, 0x7f, 0x42, 0x20   ; vmovdqu [rdx+32], ymm8
    db 0xc4, 0x63, 0x7d, 0x46, 0xc1, 0x31   ; vperm2i128 ymm8, ymm0, ymm1, 0x31
    db 0xc5, 0x3d, 0xef, 0x46, 0x40   ; vpxor ymm8, ymm8, [rsi+64]
    db 0xc5, 0x7e, 0x7f, 0x42, 0x40   ; vmovdqu [rdx+64], ymm8
    db 0xc4, 0x63, 0x6d, 0x46, 0xc3, 0x31   ; vperm2i128 ymm8, ymm2, ymm3, 0x31
    db 0xc5, 0x3d, 0xef, 0x46, 0x60   ; vpxor ymm8, ymm8, [rsi+96]
    db 0xc5, 0x7e, 0x7f, 0x42, 0x60   ; vmovdqu [rdx+96], ymm8
    db 0xc4, 0x63, 0x5d, 0x46, 0xc5, 0x20   ; vperm2i128 ymm8, ymm4, ymm5, 0x20
    db 0xc5, 0x3d, 0xef, 0x86, 0x80, 0x00, 0x00, 0x00   ; vpxor ymm8, ymm8, [rsi+128]
    db 0xc5, 0x7e, 0x7f, 0x82, 0x80, 0x00, 0x00, 0x00   ; vmovdqu [rdx+128], ymm8
    db 0xc4, 0x63, 0x4d, 0x46, 0xc7, 0x20   ; vperm2i128 ymm8, ymm6, ymm7, 0x20
    db 0xc5, 0x3d, 0xef, 0x86, 0xa0, 0x00, 0x00, 0x00   ; vpxor ymm8, ymm8, [rsi+160]
    db 0xc5, 0x7e, 0x7f, 0x82, 0xa0, 0x00, 0x00, 0x00   ; vmovdqu [rdx+160], ymm8
    db 0xc4, 0x63, 0x5d, 0x46, 0xc5, 0x31   ; vperm2i128 ymm8, ymm4, ymm5, 0x31
    db 0xc5, 0x3d, 0xef, 0x86, 0xc0, 0x00, 0x00, 0x00   ; vpxor ymm8, ymm8, [rsi+192]
    db 0xc5, 0x7e, 0x7f, 0x82, 0xc0, 0x00, 0x00, 0x00   ; vmovdqu [rdx+192], ymm8
    db 0xc4, 0x63, 0x4d, 0x46, 0xc7, 0x31   ; vperm2i128 ymm8, ymm6, ymm7, 0x31
    db 0xc5, 0x3d, 0xef, 0x86, 0xe0, 0x00, 0x00, 0x00   ; vpxor ymm8, ymm8, [rsi+224]
    db 0xc5, 0x7e, 0x7f, 0x82, 0xe0, 0x00, 0x00, 0x00   ; vmovdqu [rdx+224], ymm8
    add rsi, 256
    add rdx, 256
    db 0xc5, 0x05, 0xfe, 0xbc, 0x24, 0x80, 0x00, 0x00, 0x00   ; vpaddd ymm15, ymm15, [rsp+128]
    sub rcx, 4
    jnz next4
    db 0xc5, 0xfc, 0x77   ; vzeroall
    add rsp, 160
  done:
    ret
  }
}

/// internal: as crx_chacha_avx2_blocks, with SSSE3, two blocks per pass.
/// Needs crx_chacha_hw_level() >= 1.
/// in: nblocks >= 0 and a multiple of 2
@naked export fn crx_chacha_ssse3_blocks(st: uint32*, src: uint8*, dst: uint8*, nblocks: int64) {
  asm {
    test rcx, rcx
    jz done
    sub rsp, 64
    mov rax, 0x0504070601000302
    mov [rsp+0], rax
    mov rax, 0x0d0c0f0e09080b0a
    mov [rsp+8], rax
    mov rax, 0x0605040702010003
    mov [rsp+16], rax
    mov rax, 0x0e0d0c0f0a09080b
    mov [rsp+24], rax
    mov rax, 0x0000000000000001
    mov [rsp+32], rax
    mov rax, 0x0000000000000000
    mov [rsp+40], rax
    mov rax, 0x0000000000000002
    mov [rsp+48], rax
    mov rax, 0x0000000000000000
    mov [rsp+56], rax
    movdqu xmm10, [rsp]
    movdqu xmm11, [rsp+16]
    movdqu xmm12, [rdi]
    movdqu xmm13, [rdi+16]
    movdqu xmm14, [rdi+32]
    movdqu xmm15, [rdi+48]
  next2:
    movdqa xmm0, xmm12
    movdqa xmm1, xmm13
    movdqa xmm2, xmm14
    movdqa xmm3, xmm15
    movdqa xmm4, xmm12
    movdqa xmm5, xmm13
    movdqa xmm6, xmm14
    movdqa xmm7, xmm15
    movdqu xmm8, [rsp+32]
    paddd xmm7, xmm8
    mov eax, 10
  dround:
    paddd xmm0, xmm1
    paddd xmm4, xmm5
    pxor xmm3, xmm0
    pxor xmm7, xmm4
    db 0x66, 0x41, 0x0f, 0x38, 0x00, 0xda   ; pshufb xmm3, xmm10
    db 0x66, 0x41, 0x0f, 0x38, 0x00, 0xfa   ; pshufb xmm7, xmm10
    paddd xmm2, xmm3
    paddd xmm6, xmm7
    pxor xmm1, xmm2
    pxor xmm5, xmm6
    movdqa xmm8, xmm1
    movdqa xmm9, xmm5
    db 0x66, 0x41, 0x0f, 0x72, 0xf0, 0x0c   ; pslld xmm8, 12
    db 0x66, 0x41, 0x0f, 0x72, 0xf1, 0x0c   ; pslld xmm9, 12
    db 0x66, 0x0f, 0x72, 0xd1, 0x14   ; psrld xmm1, 20
    db 0x66, 0x0f, 0x72, 0xd5, 0x14   ; psrld xmm5, 20
    por xmm1, xmm8
    por xmm5, xmm9
    paddd xmm0, xmm1
    paddd xmm4, xmm5
    pxor xmm3, xmm0
    pxor xmm7, xmm4
    db 0x66, 0x41, 0x0f, 0x38, 0x00, 0xdb   ; pshufb xmm3, xmm11
    db 0x66, 0x41, 0x0f, 0x38, 0x00, 0xfb   ; pshufb xmm7, xmm11
    paddd xmm2, xmm3
    paddd xmm6, xmm7
    pxor xmm1, xmm2
    pxor xmm5, xmm6
    movdqa xmm8, xmm1
    movdqa xmm9, xmm5
    db 0x66, 0x41, 0x0f, 0x72, 0xf0, 0x07   ; pslld xmm8, 7
    db 0x66, 0x41, 0x0f, 0x72, 0xf1, 0x07   ; pslld xmm9, 7
    db 0x66, 0x0f, 0x72, 0xd1, 0x19   ; psrld xmm1, 25
    db 0x66, 0x0f, 0x72, 0xd5, 0x19   ; psrld xmm5, 25
    por xmm1, xmm8
    por xmm5, xmm9
    db 0x66, 0x0f, 0x70, 0xc9, 0x39   ; pshufd xmm1, xmm1, 0x39
    db 0x66, 0x0f, 0x70, 0xd2, 0x4e   ; pshufd xmm2, xmm2, 0x4e
    db 0x66, 0x0f, 0x70, 0xdb, 0x93   ; pshufd xmm3, xmm3, 0x93
    db 0x66, 0x0f, 0x70, 0xed, 0x39   ; pshufd xmm5, xmm5, 0x39
    db 0x66, 0x0f, 0x70, 0xf6, 0x4e   ; pshufd xmm6, xmm6, 0x4e
    db 0x66, 0x0f, 0x70, 0xff, 0x93   ; pshufd xmm7, xmm7, 0x93
    paddd xmm0, xmm1
    paddd xmm4, xmm5
    pxor xmm3, xmm0
    pxor xmm7, xmm4
    db 0x66, 0x41, 0x0f, 0x38, 0x00, 0xda   ; pshufb xmm3, xmm10
