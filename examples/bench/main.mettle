// Benchmark for Cryptex. Throughput in MB/s (10^6 bytes) on 16384-byte
// messages, public-key operations in microseconds per call, Argon2id in
// milliseconds. Each figure is the best of several rounds.
//   cd examples/bench && mbuild run -r
import "std/io";
import "std/time";
import "cryptex/cryptex";
import "cryptex/cipher/gcm";

const BIG: int64 = 16384;
const MIN_NS: int64 = 300000000;
const MIN_ITERS: int64 = 200;
const ROUNDS: int32 = 3;

const RSA2048_N: string = "";
const RSA2048_E: string = "260445";
const RSA2048_P: string = "f364e16ef12017ec95b192308c01e087cee619ab50a5d537cc01841dc92b30bcef0d9f2c6bbd5dc10bdf5b9f6c354a4f9f210520caa72b4f5c36b8d33f10324c55956141891e45b84b49f59ea5bfac6ffa38900aca5099afcd02f6a8257c41ce5bb2e4153832b5c22f91eb389fa2035c3cf9b3374531c483cb30ceb007259b1d";
const RSA2048_Q: string = "d95c0995fabdfcbccfe63e0f3262f806869ab571e1793e97234cbb9bd4b6872a7695389955cf6ce7245345a5df8021f7d9519563afbc2667f5311fad093de2c02cd069109b630d68e3bf767f8a788a6add7ab199f2d8f6a40b7c1910d9dab52ac80d0d333aacab321a9309dc884ddd4db637a0c1115ae3c08efa683f99eb7331";
const RSA2048_DP: string = "d4f7ef9f9be947ba9d1b3bce59e5608839a1e464553e1b6d113d0f636758bbb473a89f9949836ead40b6f314eee3ac2244d7b6f379e83f30e17783ad68d5086897889c051c26e1558a4a220bfc242995860644b5d7a3ef513ac612b9c6c0a2021bb6b9cde7dbd21fe5858746c79563e9bab7d06b43aab43a0a5cafab4519a661";
const RSA2048_DQ: string = "3db2386f174f2ea3ef4b6bd1601749ce2d6afa8be35f051178621f16a23ad36eba03c073136389241969e5b87edb0fcbcf1a0bd6e1aee97bae1f2d97aabe19b17dbe7d9492cdb68a0897f572350e846c669660dc978c5068da598524fca8a136358d3e5f8f6ad5cf78d9089c93f473189162ce0f8c4902a19902b633b3e6926d";
const RSA2048_QI: string = "ddc971183dcf3450c43e06ba2af32379eedeb2d678513fb706b75a006098154041f4b09e6be385d4b25d80ec241c899e4a986a17b0a121daab91a1e4fc5a1802a7074df3fb3f7661f0e1c97799e36d21de937cc4209585db30a56af0a228e001036ed792625e5368ce101574a2e9767f07338949f0afdf358cecd18c6d6f3f55";
const RSA3072_N: string = "";
const RSA3072_E: string = "eaf05d";
const RSA3072_P: string = "";
const RSA3072_Q: string = "";
const RSA3072_DP: string = "";
const RSA3072_DQ: string = "";
const RSA3072_QI: string = "";

struct RsaKey {
  n: uint8[384];
  nl: int64;
  e: uint8[8];
  el: int64;
  p: uint8[192];
  pl: int64;
  q: uint8[192];
  ql: int64;
  dp: uint8[192];
  dpl: int64;
  dq: uint8[192];
  dql: int64;
  qi: uint8[192];
  qil: int64;
  pss: uint8[384];
  pkcs: uint8[384];
  sl: int64;
}

var g_failed: int32 = 0;
var g_buf: uint8[16384];
var g_ct: uint8[16400];
var g_ct_len: int64 = 0;
var g_small: uint8[64];
var g_key: CrKey32;
var g_n12: CrNonce12;
var g_n24: CrNonce24;
var g_h256: CrSha256;
var g_h512: CrSha512;
var g_b2: uint8[64];
var g_hm: CrHmacSha256;
var g_gcm0: CrAesGcm;
var g_gcm1: CrAesGcm;
var g_gcm2: CrAesGcm;
var g_gcm3: CrAesGcm;
var g_xa_pk: CrX25519Public;
var g_xa_sk: CrX25519Secret;
var g_xb_pk: CrX25519Public;
var g_xb_sk: CrX25519Secret;
var g_x_out: CrX25519Shared;
var g_ed_pk: CrEd25519Public;
var g_ed_sk: CrEd25519Secret;
var g_ed_sig: CrEd25519Sig;
var g_p256_pk: uint8[65];
var g_p256_sk: CrP256Secret;
var g_p256_pk2: uint8[65];
var g_p256_sk2: CrP256Secret;
var g_p256_sh: CrKey32;
var g_p256_sig: uint8[72];
var g_p256_sl: int64 = 0;
var g_p384_pk: uint8[97];
var g_p384_sk: CrP384Secret;
var g_p384_pk2: uint8[97];
var g_p384_sk2: CrP384Secret;
var g_p384_sh: uint8[48];
var g_p384_sig: uint8[104];
var g_p384_sl: int64 = 0;
var g_rsa0: RsaKey;
var g_rsa1: RsaKey;
var g_rsa_sig: uint8[512];
var g_pwh: CrPwHash;
var g_pw: string = "correct horse battery staple";

fn pad(s: string, w: int32) -> string {
  var r: string = s;
  var i: int32 = (int32)s.length;
  while (i < w) {
    r = r + " ";
    i = i + 1;
  }
  return r;
}

fn fixed1(x10: int64) -> string {
  var w: int64 = x10 / 10;
  var f: int64 = x10 % 10;
  return "{w}.{f}";
}

fn row(name: string, what: string, res: string) {
  println(pad(name, 28) + pad(what, 22) + res);
}

fn unhex(dst: uint8*, cap: int64, s: string) -> int64 {
  var n: int64 = 0;
  if (cr_hex_decode(dst, cap, &n, s.chars, (int64)s.length) != CR_OK) {
    println("bad hex constant");
    g_failed = 1;
    return 0;
  }
  return n;
}

fn load_rsa(k: RsaKey*, n: string, e: string, p: string, q: string, dp: string, dq: string, qi: string) {
  k->nl = unhex(&k->n[0], 384, n);
  k->el = unhex(&k->e[0], 8, e);
  k->pl = unhex(&k->p[0], 192, p);
  k->ql = unhex(&k->q[0], 192, q);
  k->dpl = unhex(&k->dp[0], 192, dp);
  k->dql = unhex(&k->dq[0], 192, dq);
  k->qil = unhex(&k->qi[0], 192, qi);
}

fn rsa_view(k: RsaKey*, v: CrRsaPrivate*) {
  v->n = &k->n[0];
  v->n_len = k->nl;
  v->e = &k->e[0];
  v->e_len = k->el;
  v->p = &k->p[0];
  v->p_len = k->pl;
  v->q = &k->q[0];
  v->q_len = k->ql;
  v->dp = &k->dp[0];
  v->dp_len = k->dpl;
  v->dq = &k->dq[0];
  v->dq_len = k->dql;
  v->qinv = &k->qi[0];
  v->qinv_len = k->qil;
}

fn ok_of(b: bool) -> int32 {
  if (b) { return CR_OK; }
  return CR_E_VERIFY;
}

fn rsa_of(i: int32) -> RsaKey* {
  if (i == 0) { return &g_rsa0; }
  return &g_rsa1;
}

fn rsa_op(i: int32, op: int32) -> int32 {
  var k: RsaKey* = rsa_of(i);
  if (op == 0) {
    var v: CrRsaPrivate;
    rsa_view(k, &v);
    var sl: int64 = 0;
    return cr_rsa_sign_pss(&g_rsa_sig[0], 512, &sl, &g_small[0], 64, CR_HASH_SHA256, &v);
  }
  if (op == 1) {
    return ok_of(cr_rsa_verify_pss(&k->pss[0], k->sl, &g_small[0], 64, CR_HASH_SHA256, &k->n[0], k->nl, &k->e[0], k->el));
  }
  return ok_of(cr_rsa_verify_pkcs1(&k->pkcs[0], k->sl, &g_small[0], 64, CR_HASH_SHA256, &k->n[0], k->nl, &k->e[0], k->el));
}

fn gcm_of(i: int32) -> CrAesGcm* {
  if (i == 0) { return &g_gcm0; }
  if (i == 1) { return &g_gcm1; }
  if (i == 2) { return &g_gcm2; }
  return &g_gcm3;
}

fn op(id: int32) -> int32 {
  if (id == 0) { return cr_sha256(&g_h256, &g_buf[0], BIG); }
  if (id == 1) { return cr_sha512(&g_h512, &g_buf[0], BIG); }
  if (id == 2) { return cr_blake2b(&g_b2[0], 64, &g_buf[0], BIG, 0, 0); }
  if (id == 3) { return cr_hmac_sha256(&g_hm, &g_key.b[0], 32, &g_buf[0], BIG); }
  if (id == 4) { return cr_chacha20poly1305_encrypt(&g_ct[0], 16400, &g_ct_len, &g_buf[0], BIG, 0, 0, &g_n12, &g_key); }
  if (id == 5) { return cr_aead_encrypt(&g_ct[0], 16400, &g_ct_len, &g_buf[0], BIG, 0, 0, &g_n24, &g_key); }
  if (id >= 6 && id <= 9) { return cr_aes_gcm_encrypt(gcm_of(id - 6), &g_ct[0], 16400, &g_ct_len, &g_buf[0], BIG, 0, 0, &g_n12); }
  if (id == 10) { return cr_x25519_shared(&g_x_out, &g_xa_sk, &g_xb_pk); }
  if (id == 11) { return cr_ed25519_sign(&g_ed_sig, &g_small[0], 64, &g_ed_sk); }
  if (id == 12) { return ok_of(cr_ed25519_verify(&g_ed_sig, &g_small[0], 64, &g_ed_pk)); }
  if (id == 13) { return cr_p256_ecdh(&g_p256_sh, &g_p256_sk, &g_p256_pk2[0], 65); }
  if (id == 14) { return cr_p256_ecdsa_sign(&g_p256_sig[0], 72, &g_p256_sl, &g_small[0], 64, CR_HASH_SHA256, &g_p256_sk); }
  if (id == 15) { return ok_of(cr_p256_ecdsa_verify(&g_p256_sig[0], g_p256_sl, &g_small[0], 64, CR_HASH_SHA256, &g_p256_pk[0], 65)); }
  if (id == 16) { return cr_p384_ecdh(&g_p384_sh[0], 48, &g_p384_sk, &g_p384_pk2[0], 97); }
  if (id == 17) { return cr_p384_ecdsa_sign(&g_p384_sig[0], 104, &g_p384_sl, &g_small[0], 64, CR_HASH_SHA384, &g_p384_sk); }
  if (id == 18) { return ok_of(cr_p384_ecdsa_verify(&g_p384_sig[0], g_p384_sl, &g_small[0], 64, CR_HASH_SHA384, &g_p384_pk[0], 97)); }
  if (id >= 19 && id <= 24) { return rsa_op((id - 19) / 3, (id - 19) % 3); }
  if (id == 25) { return cr_pwhash_str(&g_pwh, g_pw.chars, (int64)g_pw.length, CR_PW_INTERACTIVE); }
  return CR_E_ARG;
}

fn setup() -> bool {
  var i: int32 = 0;
  while (i < 16384) {
    g_buf[i] = (uint8)(i * 7 + 3);
    i = i + 1;
  }
  i = 0;
  while (i < 64) {
    g_small[i] = (uint8)(i * 5 + 1);
    i = i + 1;
  }
  i = 0;
  while (i < 32) {
    g_key.b[i] = (uint8)(i + 11);
    i = i + 1;
  }
  i = 0;
  while (i < 12) {
    g_n12.b[i] = (uint8)(i + 1);
    i = i + 1;
  }
  i = 0;
  while (i < 24) {
    g_n24.b[i] = (uint8)(i + 1);
    i = i + 1;
  }
  if (cr_aes_gcm_init(&g_gcm0, &g_key.b[0], 16) != CR_OK) { return false; }
  if (cr_aes_gcm_init(&g_gcm1, &g_key.b[0], 32) != CR_OK) { return false; }
  if (cr_aes_gcm_init(&g_gcm2, &g_key.b[0], 16) != CR_OK) { return false; }
  if (cr_aes_gcm_init(&g_gcm3, &g_key.b[0], 32) != CR_OK) { return false; }
  crx_aes_gcm_force_portable(&g_gcm2);
  crx_aes_gcm_force_portable(&g_gcm3);
  if (cr_x25519_keypair(&g_xa_pk, &g_xa_sk) != CR_OK) { return false; }
  if (cr_x25519_keypair(&g_xb_pk, &g_xb_sk) != CR_OK) { return false; }
  if (cr_ed25519_keypair(&g_ed_pk, &g_ed_sk) != CR_OK) { return false; }
  if (cr_ed25519_sign(&g_ed_sig, &g_small[0], 64, &g_ed_sk) != CR_OK) { return false; }
  if (cr_p256_keypair(&g_p256_pk[0], 65, &g_p256_sk) != CR_OK) { return false; }
  if (cr_p256_keypair(&g_p256_pk2[0], 65, &g_p256_sk2) != CR_OK) { return false; }
  if (op(14) != CR_OK) { return false; }
  if (cr_p384_keypair(&g_p384_pk[0], 97, &g_p384_sk) != CR_OK) { return false; }
  if (cr_p384_keypair(&g_p384_pk2[0], 97, &g_p384_sk2) != CR_OK) { return false; }
  if (op(17) != CR_OK) { return false; }
  load_rsa(&g_rsa0, RSA2048_N, RSA2048_E, RSA2048_P, RSA2048_Q, RSA2048_DP, RSA2048_DQ, RSA2048_QI);
  load_rsa(&g_rsa1, RSA3072_N, RSA3072_E, RSA3072_P, RSA3072_Q, RSA3072_DP, RSA3072_DQ, RSA3072_QI);
  if (g_failed != 0) { return false; }
  i = 0;
  while (i < 2) {
    var k: RsaKey* = rsa_of(i);
    var v: CrRsaPrivate;
    rsa_view(k, &v);
    var l1: int64 = 0;
    var l2: int64 = 0;
    if (cr_rsa_sign_pss(&k->pss[0], 384, &l1, &g_small[0], 64, CR_HASH_SHA256, &v) != CR_OK) { return false; }
    if (cr_rsa_sign_pkcs1(&k->pkcs[0], 384, &l2, &g_small[0], 64, CR_HASH_SHA256, &v) != CR_OK) { return false; }
    if (l1 != k->nl || l2 != k->nl) { return false; }
    k->sl = l1;
    i = i + 1;
  }
  return true;
}

fn measure(id: int32, min_ns: int64, min_iters: int64, rounds: int32) -> int64 {
  var best: int64 = 0;
  var r: int32 = 0;
  while (r < rounds) {
    var t0: int64 = time_mono_ns();
    var n: int64 = 0;
    var el: int64 = 0;
    var done: bool = false;
    while (!done) {
      var st: int32 = op(id);
      if (st != CR_OK) {
        println("call {id} failed with status {st}");
        g_failed = 1;
        return 0;
      }
      n = n + 1;
      el = time_mono_ns() - t0;
      if (el >= min_ns && n >= min_iters) { done = true; }
    }
    var per: int64 = el / n;
    if (per < 1) { per = 1; }
    if (best == 0 || per < best) { best = per; }
    r = r + 1;
  }
  return best;
}

fn thr(name: string, id: int32) {
  var ns: int64 = measure(id, MIN_NS, MIN_ITERS, ROUNDS);
  if (ns == 0) {
    row(name, "16384 bytes", "FAILED");
    return;
  }
  var x10: int64 = BIG * 10000 / ns;
  row(name, "16384 bytes", fixed1(x10) + " MB/s");
}

fn per_op(name: string, what: string, id: int32) {
  var ns: int64 = measure(id, MIN_NS, MIN_ITERS, ROUNDS);
  if (ns == 0) {
    row(name, what, "FAILED");
    return;
  }
  row(name, what, fixed1(ns / 100) + " us");
}

fn main() -> int32 {
  var t_all: int64 = time_mono_ns();
  if (!setup()) {
    println("setup failed");
    return 1;
  }
  println("Cryptex benchmark (best of {ROUNDS} rounds, at least 0.3 s or 200 calls per round)");
  if (g_gcm0.hw == 1) {
    println("AES-GCM default path: AES-NI and PCLMULQDQ");
  } else {
    println("AES-GCM default path: portable");
  }
  println("");
  row("name", "size or operation", "result");
  println("--------------------------------------------------------------");
  thr("SHA-256", 0);
  thr("SHA-512", 1);
  thr("BLAKE2b-512", 2);
  thr("HMAC-SHA256", 3);
  thr("ChaCha20-Poly1305", 4);
  thr("XChaCha20-Poly1305", 5);
  thr("AES-128-GCM", 6);
  thr("AES-256-GCM", 7);
  thr("AES-128-GCM portable", 8);
  thr("AES-256-GCM portable", 9);
  per_op("X25519", "shared secret", 10);
  per_op("Ed25519", "sign, 64 bytes", 11);
  per_op("Ed25519", "verify, 64 bytes", 12);
  per_op("P-256", "ECDH", 13);
  per_op("P-256 ECDSA SHA-256", "sign", 14);
  per_op("P-256 ECDSA SHA-256", "verify", 15);
  per_op("P-384", "ECDH", 16);
  per_op("P-384 ECDSA SHA-384", "sign", 17);
  per_op("P-384 ECDSA SHA-384", "verify", 18);
  per_op("RSA-2048 PSS SHA-256", "sign", 19);
  per_op("RSA-2048 PSS SHA-256", "verify", 20);
  per_op("RSA-2048 PKCS#1 SHA-256", "verify", 21);
  per_op("RSA-3072 PSS SHA-256", "sign", 22);
  per_op("RSA-3072 PSS SHA-256", "verify", 23);
  per_op("RSA-3072 PKCS#1 SHA-256", "verify", 24);
  var ns: int64 = measure(25, 0, 1, 3);
  if (ns == 0) {
    row("Argon2id INTERACTIVE", "hash a password", "FAILED");
  } else {
    row("Argon2id INTERACTIVE", "hash a password", fixed1(ns / 100000) + " ms");
  }
  var total_ms: int64 = (time_mono_ns() - t_all) / 1000000;
  var s: int64 = total_ms / 1000;
  var ms: int64 = total_ms % 1000;
  println("");
  println("total time: {s}.{ms} s");
  cr_wipe(&g_key.b[0], 32);
  if (g_failed != 0) { return 1; }
  return 0;
}
