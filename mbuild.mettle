import "mbuild/api";

// crypto: misuse-resistant crypto for Mettle, written in pure Mettle.
// No C and no shared libraries; randomness comes from the getrandom syscall.
//
// Layout: src/crypto.mettle is the facade; modules sit in src/<area>/.
// Tests: tests/<name>_test.mettle (data in tests/vectors/), run with
// `mbuild test` and `mbuild test -r`. examples/basic is a small project that
// uses crypto the way a dependent does.
fn project() {
  mb_package("crypto", "0.2.4");
  mb_meta("description", "misuse-resistant crypto in pure Mettle: SHA-2, BLAKE2b, HMAC, Argon2id, XChaCha20-Poly1305, X25519, Ed25519, TOTP, hex/base64url, signed values, tokens, seal/open");
  mb_meta("license", "Apache-2.0");
  mb_import_root("src");
}

fn deps() {
}
